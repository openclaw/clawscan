+    def _chat_responses(self, message: list[dict]) -> tuple[str, dict]:
+        # AIG tools are XML in ordinary text, not OpenAI function/tool calls.
+        # Replay the complete local history without creating server-side state.
+        history = []
+        for item in message:
+            role, content = item.get("role"), item.get("content")
+            if role not in {"system", "developer", "user", "assistant"} or not isinstance(
+                content, str
+            ):
+                raise ValueError("GPT-6.1 Sol requires AIG text message history")
+            history.append({"role": role, "content": content})
+
+        started = time.monotonic()
+        budget = getattr(self, "stream_timeout", 300)
+        if budget <= 0 or not math.isfinite(budget):
+            raise TimeoutError("LLM streaming response deadline must be positive")
+        deadline = started + budget
+        effort = (get_env("REASONING_EFFORT") or "").strip()
+        options = {"reasoning": {"effort": effort}} if effort else {}
+        tier = (get_env("AIG_SERVICE_TIER") or "default").strip() or "default"
+        if tier not in {"auto", "default", "flex", "priority"}:
+            raise ValueError("Unsupported AIG_SERVICE_TIER")
+        options["service_tier"] = tier
+        call_id = uuid.uuid4().hex
+        outcome = Future()
+        ready = Future()
+        cancelled = threading.Event()
+        finished = threading.Event()
+        startup_settled = threading.Event()
+        deferred = []
+        try:
+            caller = asyncio.current_task()
+        except RuntimeError:
+            caller = None
+
+        async def complete():
+            ready.set_result((asyncio.get_running_loop(), asyncio.current_task()))
+            while deferred and not startup_settled.is_set():
+                await asyncio.sleep(0.001)
+            if cancelled.is_set():
+                raise asyncio.CancelledError()
+            try:
+                return await asyncio.wait_for(
+                    self._responses_attempts(history, options, deadline, call_id, cancelled),
+                    timeout=max(0, deadline - time.monotonic()),
+                )
+            except asyncio.TimeoutError:
+                raise TimeoutError(
+                    f"LLM streaming response exceeded the {budget}-second deadline"
+                ) from None
+
+        def run():
+            try:
+                outcome.set_result(asyncio.run(complete()))
+            except BaseException as exc:
+                outcome.set_exception(exc)
+            finally:
+                finished.set()
+
+        worker = threading.Thread(target=run, name="aig-responses")
+        aborted = None
+
+        def defer_interrupt(signum, frame):
+            deferred.append((signum, frame))
+
+        def request_cancel(task):
+            if not task.cancelling():
+                task.cancel()
+
+        abort_scheduled = False
+        startup_attempted = False
+        previous_handler = None
+        replayed = 0
+        while True:
+            try:
+                if not startup_attempted:
+                    startup_attempted = True
+                    try:
+                        if caller is not None and caller.cancelling():
+                            raise asyncio.CancelledError()
+                        if threading.current_thread() is threading.main_thread():
+                            handler = signal.getsignal(signal.SIGINT)
+                            if callable(handler):
+                                previous_handler = handler
+                                signal.signal(signal.SIGINT, defer_interrupt)
+                        worker.start()
+                    finally:
+                        if previous_handler is not None:
+                            signal.signal(signal.SIGINT, previous_handler)
+                if replayed < len(deferred):
+                    signum, frame = deferred[replayed]
+                    replayed += 1
+                    previous_handler(signum, frame)
+                    continue
+                if aborted is None and caller is not None and caller.cancelling():
+                    raise asyncio.CancelledError()
+                if aborted is not None and not abort_scheduled:
+                    cancelled.set()
+                    if ready.done() and not outcome.done():
+                        loop, task = ready.result()
+                        try:
+                            loop.call_soon_threadsafe(request_cancel, task)
+                        except RuntimeError:
+                            pass
+                    abort_scheduled = True
+                startup_settled.set()
+                if worker not in threading.enumerate() and (
+                    finished.is_set() or aborted is not None
+                ):
+                    break
+                finished.wait(0.01)
+            except BaseException as exc:
+                if aborted is None:
+                    aborted = exc
+        if aborted is not None:
+            raise aborted
+        if caller is not None and caller.cancelling():
+            raise asyncio.CancelledError()
+        return outcome.result()
+
+    @staticmethod
+    def _responses_transient(exc):
+        body = exc.body if isinstance(exc.body, dict) else {}
+        code = body.get("code")
+        kind = body.get("type")
+        status = getattr(exc, "status_code", None)
+        if not isinstance(code, (str, type(None))) or not isinstance(kind, (str, type(None))):
+            return None
+        if code == "server_is_overloaded" and kind in {None, "service_unavailable_error"}:
+            return "overload" if status in {None, 503} else None
+        if code == "slow_down" and kind in {None, "rate_limit_error"}:
+            return "slow_down" if status in {None, 429} else None
+        if code == "server_error" and kind in {None, "server_error", "api_error"}:
+            return "server_error" if status in {None, 500, 503} else None
+        if (
+            type(exc) is openai.APIError
+            and status is None
+            and code is None
+            and kind in {None, "server_error", "api_error", "service_unavailable_error"}
+            and body.get("message")
+            == "Our servers are currently overloaded. Please try again later."
+        ):
+            return "legacy_overload"
+        return None
+
+    @staticmethod
+    def _responses_retry_delay(attempt, headers):
+        delay = float(2 ** (attempt - 1))
+        hint = headers.get("retry-after")
+        if hint is not None:
+            try:
+                server_delay = float(hint)
+            except ValueError:
+                try:
+                    server_delay = (
+                        parsedate_to_datetime(hint) - datetime.now(timezone.utc)
+                    ).total_seconds()
+                except (ValueError, TypeError, OverflowError):
+                    server_delay = -1
+            if math.isfinite(server_delay) and server_delay >= 0:
+                delay = max(delay, server_delay)
+        if delay > 10:
+            raise RuntimeError("OpenAI Responses retry delay exceeds limit")
+        return delay + random.uniform(0, min(0.25, 10 - delay))
+
+    @staticmethod
+    async def _responses_close(close):
+        cleanup = asyncio.create_task(close())
+        aborted = None
+        while True:
+            try:
+                await asyncio.shield(cleanup)
+                break
+            except asyncio.CancelledError as exc:
+                if cleanup.cancelled():
+                    raise
+                if aborted is None:
+                    aborted = exc
+            except BaseException:
+                if aborted is not None:
+                    raise aborted
+                raise
+        if aborted is not None:
+            raise aborted
+
+    async def _responses_attempts(self, history, options, deadline, call_id, cancelled):
+        client = openai.AsyncOpenAI(
+            api_key=self.api_key,
+            base_url=self.base_url,
+            default_headers=self._responses_headers,
+            max_retries=0,
+            timeout=min(60, max(0.001, deadline - time.monotonic())),
+        )
+        try:
+            for attempt in range(1, 4):
+                if cancelled.is_set():
+                    raise asyncio.CancelledError()
+                if time.monotonic() >= deadline:
+                    raise TimeoutError("OpenAI Responses response deadline exceeded")
+                response = None
+                headers = {}
+                logger.info(f"aig_provider_attempt v=1 call={call_id} attempt={attempt} outcome=started")
+                try:
+                    response = await client.with_options(
+                        timeout=min(60, max(0.001, deadline - time.monotonic())),
+                        max_retries=0,
+                    ).responses.create(
+                        model=self.model, input=history, stream=True, store=False, **options
+                    )
+                    headers = response.response.headers
+                    try:
+                        result = await self._responses_output(response)
+                    finally:
+                        await self._responses_close(response.close)
+                except openai.APIError as exc:
+                    category = self._responses_transient(exc)
+                    logger.info(f"aig_provider_attempt v=1 call={call_id} attempt={attempt} outcome=failed category={category or 'nonretryable'}")
+                    if category is None or attempt == 3:
+                        raise RuntimeError("OpenAI Responses provider error; no completed audit") from None
+                    if getattr(exc, "response", None) is not None:
+                        headers = exc.response.headers
+                    delay = self._responses_retry_delay(attempt, headers)
+                    if delay >= deadline - time.monotonic():
+                        raise TimeoutError("OpenAI Responses retry exceeds remaining deadline") from None
+                    await asyncio.sleep(delay)
+                except BaseException:
+                    logger.info(f"aig_provider_attempt v=1 call={call_id} attempt={attempt} outcome=failed category=operational")
+                    raise
+                else:
+                    logger.info(f"aig_provider_attempt v=1 call={call_id} attempt={attempt} outcome=completed")
+                    return result
+        finally:
+            await self._responses_close(client.close)
+
+    async def _responses_output(self, response):
+        async for event in response:
+            if event.type == "response.refusal.delta":
+                raise RuntimeError("OpenAI Responses refused the audit request")
+            elif event.type == "response.incomplete":
+                raise RuntimeError("OpenAI Responses incomplete audit")
+            elif event.type in {"response.failed", "error"}:
+                error = event.response.error if event.type == "response.failed" else event
+                raise openai.APIError(
+                    "OpenAI Responses provider error",
+                    request=response.response.request,
+                    body={
+                        "code": getattr(error, "code", None),
+                        "type": getattr(error, "type", None) if event.type != "error" else None,
+                        "message": getattr(error, "message", None),
+                    },
+                )
+            elif event.type == "response.completed":
+                result = event.response
+                if result.status != "completed":
+                    raise RuntimeError("OpenAI Responses unexpected status")
+                for item in result.output:
+                    if item.type == "message" and any(part.type == "refusal" for part in item.content):
+                        raise RuntimeError("OpenAI Responses refused the audit request")
+                text = result.output_text
+                if not text.strip():
+                    raise RuntimeError("OpenAI Responses completed an empty audit")
+                usage = result.usage
+                return text, (
+                    {
+                        "prompt_tokens": usage.input_tokens,
+                        "completion_tokens": usage.output_tokens,
+                        "total_tokens": usage.total_tokens,
+                    }
+                    if usage is not None else None
+                )
+        raise RuntimeError("OpenAI Responses stream ended without response.completed")
+
     def _normalize_usage(self, usage) -> dict | None:
         if not usage:
             return None
