+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""A deliberately small, closed value/use proof for JavaScript data strings.
+
+Native filesystem paths, fetch URLs, stream writes, and directly thrown Error
+messages do not interpret strings as shell source. A spelling alone proves
+nothing: imports, immutable aliases, every local value use, and ambient-name
+shadowing are checked against the complete parsed module. Unsupported value
+flows grant no ownership for the artifact.
+"""
+
+import re
+from collections import defaultdict
+
+_GLOBAL_CAPABILITIES = {
+    "Error",
+    "fetch",
+    "process",
+    "JSON",
+    "String",
+    "Buffer",
+    "Math",
+    "Object",
+    "Array",
+    "Set",
+    "URL",
+}
+_FORBIDDEN_GLOBALS = {
+    "globalThis",
+    "global",
+    "window",
+    "self",
+    "Reflect",
+    "eval",
+    "Function",
+    "require",
+}
+_NATIVE_MODULES = {
+    "node:fs",
+    "node:fs/promises",
+    "node:path",
+    "node:crypto",
+    "node:stream",
+    "node:stream/promises",
+}
+_FS_PATH_ARGUMENTS = {
+    "createWriteStream": {0},
+    "readFile": {0},
+    "readFileSync": {0},
+    "statSync": {0},
+    "open": {0},
+    "rename": {0, 1},
+    "rm": {0},
+    "mkdir": {0},
+    "stat": {0},
+}
+MAX_PROOF_STEPS = 100_000
+
+
+class OwnershipBudgetExceededError(Exception):
+    pass
+
+
+def data_literal_ranges(data, nodes, parents, check_runtime, *, opaque_only=False):
+    """Return proven data ranges and authored values reaching unresolved sinks.
+
+    Strict mode refuses ownership when any native identity assumption is unproved.
+    Opaque-only mode grants no ranges and distinguishes actual unknown call
+    arguments from an unobserved export, return or unused result.
+    """
+    definitions = defaultdict(list)
+    references = defaultdict(list)
+    imported = {}
+    remaining = MAX_PROOF_STEPS
+    unsupported = []
+    native_values = None
+    diagnostic_values = None
+    computed_storage_roots = set()
+    error_handler_active = False
+    error_handler_result = None
+    error_binding_ids = set()
+    escaped_json_identity = False
+    unsafe_native = any(
+        n.type == "with_statement"
+        or (n.type == "method_definition" and any(c.type in {"get", "set"} for c in n.children))
+        for n in nodes
+    )
+
+    def step():
+        nonlocal remaining
+        remaining -= 1
+        if remaining < 0:
+            raise OwnershipBudgetExceededError
+        check_runtime()
+
+    def text(node):
+        raw = data[node.start_byte : node.end_byte].decode("utf-8")
+        if opaque_only and node.type in {
+            "identifier",
+            "property_identifier",
+            "shorthand_property_identifier",
+            "shorthand_property_identifier_pattern",
+        }:
+            return re.sub(
+                r"\\u(?:\{([0-9a-fA-F]+)\}|([0-9a-fA-F]{4}))",
+                lambda match: chr(int(match.group(1) or match.group(2), 16)),
+                raw,
+            )
+        return raw
+
+    def parent(node):
+        return parents.get(node.id)
+
+    def field(node, name):
+        return node.child_by_field_name(name)
+
+    def semantic_children(node):
+        return [child for child in node.named_children if child.type != "comment"]
+
+    def const_declaration(node):
+        p = parent(node)
+        return (
+            p is not None
+            and p.type == "lexical_declaration"
+            and data[p.start_byte : p.start_byte + 5] == b"const"
+        )
+
+    def bindings(initial, *, assignment=False):
+        """Walk grammar-owned binding targets, never object keys/default values."""
+        pending = [initial]
+        while pending:
+            step()
+            node = pending.pop()
+            if node is None:
+                continue
+            if node.type in {"identifier", "shorthand_property_identifier_pattern"}:
+                yield node
+            elif assignment and node.type in {"member_expression", "subscript_expression"}:
+                yield node
+            elif node.type in {"assignment_pattern", "object_assignment_pattern"}:
+                pending.append(field(node, "left"))
+            elif node.type == "pair_pattern":
+                pending.append(field(node, "value"))
+            elif node.type in {
+                "formal_parameters",
+                "object_pattern",
+                "array_pattern",
+                "rest_pattern",
+                "parenthesized_expression",
+            }:
