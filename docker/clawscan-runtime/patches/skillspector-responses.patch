+        for block in blocks:
+            check_runtime()
+            if block.type == "table_open":
+                table_depth += 1
+            elif block.type == "table_close":
+                table_depth -= 1
+            # Table cells unescape pipes and share a whole-row map. A substring
+            # elsewhere in that row is not proof of this cell's raw origin.
+            if table_depth or block.type == "table_close":
+                continue
+            if block.type != "inline" or not block.map or not block.content:
+                continue
+            start_line, end_line = block.map
+            if end_line >= len(starts):
