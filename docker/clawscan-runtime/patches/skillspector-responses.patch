@@ -0,0 +1,123 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""Exact structural evidence for a narrow, passive PCM WAVE carrier.
+
+This evidence describes binary exclusion; it never claims text/semantic inspection.
+Unknown chunks and codecs remain unsupported rather than receiving an exemption.
+"""
+
+from __future__ import annotations
+
+import struct
+from collections.abc import Mapping
+from pathlib import PurePosixPath
+
+_FIELDS = frozenset(
+    {
+        "format",
+        "channels",
+        "sample_rate",
+        "bits_per_sample",
+        "block_align",
+        "byte_rate",
+        "data_bytes",
+        "frames",
+        "container_bytes",
+    }
+)
+
+
+def validated_wave_evidence(value: object, size_bytes: object) -> dict[str, object] | None:
+    """Validate the entire versioned wire contract, including integer arithmetic."""
+    if not isinstance(value, Mapping) or set(value) != _FIELDS:
+        return None
+    if value["format"] != "riff_wave_pcm_v1":
+        return None
+    if type(size_bytes) is not int or not 44 < size_bytes <= 0xFFFFFFFF + 8:
+        return None
+    if any(type(value[key]) is not int for key in _FIELDS - {"format"}):
+        return None
+    channels = value["channels"]
+    rate = value["sample_rate"]
+    bits = value["bits_per_sample"]
+    if not 1 <= channels <= 8 or not 1 <= rate <= 384000 or bits not in (8, 16, 24, 32):
+        return None
+    block = channels * (bits // 8)
+    length = value["data_bytes"]
+    if not 0 < length <= 0xFFFFFFFF or length % block:
+        return None
+    if (
+        value["block_align"] != block
+        or value["byte_rate"] != rate * block
+        or value["frames"] != length // block
+        or value["container_bytes"] != size_bytes
+        or size_bytes != 44 + length + length % 2
+    ):
+        return None
+    return dict(value)
+
+
+def passive_wave_component(component: Mapping[str, object]) -> bool:
+    """Restrict evidence to visible, top-level, non-executable binary assets."""
+    path = component.get("path")
+    if not isinstance(path, str) or not path or "\\" in path or "!/" in path or "\x00" in path:
+        return False
+    parts = path.split("/")
+    if any(not part or part.startswith(".") for part in parts):
+        return False
+    if PurePosixPath(path).suffix.lower() != ".wav":
+        return False
+    return (
+        component.get("type") == "other"
+        and component.get("executable") is False
+        and type(component.get("lines")) is int
+        and component["lines"] >= 0
+        and not any(
+            component.get(key)
+            for key in (
+                "hidden",
+                "local_only",
+                "hidden_ancestor",
+                "source_local_only",
+                "outer_path",
+                "nested_path",
+                "container_type",
+                "container_ancestry",
+                "container_depth",
+                "concealed_executable",
+            )
+        )
+    )
+
+
+def passive_wave_evidence(data: bytes) -> dict[str, object] | None:
+    """Prove complete RIFF/WAVE, canonical fmt(PCM) + data, with no trailer."""
+    if len(data) <= 44 or data[:4] != b"RIFF" or data[8:12] != b"WAVE":
+        return None
+    if data[12:16] != b"fmt " or data[36:40] != b"data":
+        return None
+    (container,) = struct.unpack_from("<I", data, 4)
+    fmt_size, codec, channels, rate, byte_rate, block, bits = struct.unpack_from(
+        "<IHHIIHH", data, 16
+    )
+    (length,) = struct.unpack_from("<I", data, 40)
+    if container != len(data) - 8 or fmt_size != 16 or codec != 1:
+        return None
+    evidence = validated_wave_evidence(
+        {
+            "format": "riff_wave_pcm_v1",
+            "channels": channels,
+            "sample_rate": rate,
+            "bits_per_sample": bits,
+            "block_align": block,
+            "byte_rate": byte_rate,
+            "data_bytes": length,
+            "frames": length // block if block else 0,
+            "container_bytes": len(data),
+        },
+        len(data),
+    )
+    if evidence is None or (length % 2 and data[-1:] != b"\x00"):
+        return None
+    return evidence
