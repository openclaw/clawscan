+        # unavailable, preserve that fallback rather than asserting coverage.
+        if len(content) > 1_048_576:
+            return
+        # CommonMark normalizes physical newlines before inline parsing. Keep
+        # an exact map back to raw characters; the artifact is never rewritten.
+        source_offsets = array("I")
+        normalized = []
+        cursor = 0
+        while cursor < len(content):
+            if cursor % 4096 == 0:
+                check_runtime()
+            char = content[cursor]
+            source_offsets.append(cursor)
+            normalized.append("\n" if char == "\r" else char)
+            cursor += 2 if content.startswith("\r\n", cursor) else 1
+        source_offsets.append(len(content))
+        content = "".join(normalized)
+        parser = MarkdownIt("commonmark").enable("table")
+        # Observe the original document parse, including its reference-link
+        # environment. Each nested image state has a distinct source object;
+        # keep strong source references so identities cannot be reused.
+        records: dict[int, tuple[str, set[int], set[int]]] = {}
+
+        def record_backtick(state, silent):
+            check_runtime()
+            before = len(state.tokens)
+            opening_start = state.pos
+            matched = backtick(state, silent)
+            if matched and not silent and len(state.tokens) > before:
+                token = state.tokens[-1]
+                if token.type == "code_inline":
