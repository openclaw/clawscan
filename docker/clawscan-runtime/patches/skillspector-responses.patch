+    def known_nonstring_result(node):
+        function = field(node, "function")
+        cap = capability(function)
+        if cap == ("ambient", "Math.min"):
+            return True
+        if cap == ("ambient", "Object.assign"):
+            arguments = field(node, "arguments")
+            if arguments is not None and semantic_children(arguments):
+                target = semantic_children(arguments)[0]
+                if target.type == "new_expression" and capability(field(target, "constructor")) == (
+                    "ambient",
+                    "Error",
+                ):
+                    return True
+        if cap in {
+            ("ambient", "process.getBuiltinModule"),
+            ("ambient", "process.argv.slice"),
+            ("ambient", "Buffer.alloc"),
+            ("ambient", "fetch"),
+            ("ambient", "process.stdout.write"),
+            ("ambient", "process.stderr.write"),
+        }:
