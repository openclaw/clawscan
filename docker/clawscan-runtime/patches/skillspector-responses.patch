@@ -0,0 +1,170 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Bounded syntax ownership after a closed JavaScript value/use proof.
+
+Unresolved constructed values retain incomplete coverage. Proven data literal
+syntax and comments cannot consume later host code as shell operands. Findings always
+inspect the original source, including every interpolation expression.
+"""
+
+from __future__ import annotations
+
+import re
+from bisect import bisect_right
+from collections.abc import Callable
+
+from skillspector.javascript_values import OwnershipBudgetExceededError, data_literal_ranges
+
+MAX_SOURCE_BYTES = 262_144
+MAX_NODES = 100_000
+MAX_DEPTH = 256
+PARSE_TIMEOUT_MICROS = 100_000
+_JAVASCRIPT_SHEBANG = re.compile(
+    r"#![ \t]*+(?:\S*/)?(?:env[ \t]++(?:-\S*[ \t]++)*(?:\S*/)?)?"
+    r"(?:node|nodejs|bun|deno)(?=[ \t\r\n]|$)"
+)
+
+
+class JavaScriptSourceOwnership:
+    def __init__(self, content: str, check_runtime: Callable[[], None]):
+        self._content = content
+        self._check_runtime = check_runtime
+        self._spans: tuple[tuple[int, ...], tuple[int, ...]] | None = None
+        self._literals: tuple[tuple[int, ...], tuple[int, ...]] | None = None
+        self._unsupported: tuple[tuple[int, ...], tuple[int, ...]] | None = None
+        self._computed = False
+
+    def _compute(self):
+        if not self._computed:
+            result = _source_spans(self._content, self._check_runtime)
+            if result is not None:
+                self._spans, self._literals, self._unsupported = result
+            self._computed = True
+
+    def _owner(self, spans, position):
+        if spans is None:
+            return None
+        starts, ends = spans
+        index = bisect_right(starts, position) - 1
+        if index >= 0 and position < ends[index]:
+            return starts[index], ends[index]
+        return None
+
+    def comment(self, position: int) -> tuple[int, int] | None:
+        self._compute()
+        return self._owner(self._spans, position)
+
+    def data_literal(self, position: int) -> tuple[int, int] | None:
+        self._compute()
+        return self._owner(self._literals, position)
+
+    def analysis_incomplete(self) -> bool:
+        """A missing/bounded parse cannot mean successful empty construction analysis."""
+        self._compute()
+        return self._unsupported is None
+
+    def unsupported_values(self) -> tuple[tuple[int, int], ...]:
+        self._compute()
+        if self._unsupported is None:
+            return ()
+        return tuple(zip(*self._unsupported, strict=True))
+
+
+def _source_spans(
+    content: str, check_runtime: Callable[[], None]
+) -> (
+    tuple[
+        tuple[tuple[int, ...], tuple[int, ...]],
+        tuple[tuple[int, ...], tuple[int, ...]],
+        tuple[tuple[int, ...], tuple[int, ...]],
+    ]
+    | None
+):
+    if len(content) > MAX_SOURCE_BYTES or (
+        content.startswith("#!") and _JAVASCRIPT_SHEBANG.match(content) is None
+    ):
+        return None
+    check_runtime()
+    try:
+        data = content.encode("utf-8")
+    except UnicodeError:
+        return None
+    if len(data) > MAX_SOURCE_BYTES:
+        return None
