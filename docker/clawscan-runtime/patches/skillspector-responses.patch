+                    return False
+                continue
+            if cap == ("ambient", "JSON.stringify"):
+                if not json_call_has_inert_options(cap, args) or not self._serializable(args[0]):
+                    return False
+                continue
+            if self.kind(node) is None:
+                return False
+        return True
+
+    def _operands_are_data(self, node):
+        """Affirmatively own each semantic form and its implicit dispatch."""
+        if not node.is_named or node.type in self._STRUCTURAL_NODES:
+            return True
+        operands = []
+        if node.type in {"template_substitution", "computed_property_name", "await_expression"}:
+            # Await assimilates a thenable before its result reaches a scalar
+            # consumer. Known native readFile results have their settled string
+            # kind; unknown objects cannot be admitted through Boolean(await x).
+            operands = self.children(node)
+            if len(operands) != 1:
+                return False
+        elif node.type == "member_expression":
+            return self._native_member_read(node)
+        elif node.type == "subscript_expression":
+            if not self._native_member_read(node):
+                return False
+            operands = [self.field(node, "index")]
+        elif node.type in {"binary_expression", "augmented_assignment_expression"}:
+            operator = self.field(node, "operator")
+            op = self.text(operator) if operator is not None else ""
+            allowed = (
+                self._BINARY_OPERATORS
+                if node.type == "binary_expression"
+                else self._AUGMENTED_OPERATORS
+            )
+            if op not in allowed:
+                return False
+            # Truthiness, nullish selection and strict identity do not invoke
+            # an object's conversion hooks. Arithmetic, relational and loose
+            # equality operations can, even when their result is primitive.
+            if op not in {"??", "||", "&&", "===", "!==", "??=", "||=", "&&="}:
+                operands = [self.field(node, side) for side in ("left", "right")]
+        elif node.type in {"unary_expression", "update_expression"}:
+            operator = self.field(node, "operator")
+            op = self.text(operator) if operator is not None else ""
+            allowed = (
+                {"++", "--"} if node.type == "update_expression"
+                else {"!", "typeof", "void", "delete", "+", "-", "~"}
+            )
+            if op not in allowed:
+                return False
+            if op in {"+", "-", "~", "++", "--"}:
+                operands = [self.field(node, "argument")]
+        elif node.type == "for_in_statement":
+            # Async iteration additionally assimilates yielded thenables.
+            # Enumeration/proxy contracts are outside this validator owner.
+            return (
+                any(child.type == "of" for child in node.children)
+                and not any(child.type == "await" for child in node.children)
+                and self._native_iterable(self.field(node, "right"))
+            )
+        elif node.type == "spread_element":
+            owner = self.parent(node)
+            values = self.children(node)
+            return (
+                owner is not None and owner.type == "array" and len(values) == 1
+                and self._native_iterable(values[0])
+            )
+        elif node.type in {"call_expression", "new_expression"}:
+            # Tagged templates are call_expression nodes too, but consume a
+            # template object through a different, unproved invocation contract.
+            arguments = self.field(node, "arguments")
+            return arguments is not None and arguments.type == "arguments"
+        else:
+            return False
+        return all(self.primitive(self.kind(operand)) for operand in operands)
+
+    def _native_iterable(self, node):
+        kind = self.kind(node)
+        return kind is not None and kind[0] in {"array", "iterator", "string"}
+
+    def _native_member_read(self, node):
+        if self.capability(node) is not None:
+            return True
+        receiver = self.field(node, "object")
+        kind = self.kind(receiver)
+        if self.primitive(kind, error=True) or (
+            kind is not None and kind[0] in {"array", "iterator", "match", "regexp"}
+        ):
+            return True
+        # Property access can invoke an inherited getter even when only the
+        # property's boolean result is observed. Plain-record ownership also
+        # excludes prototypes, accessors, hooks and subsequent member writes.
+        return self._serializable(receiver)
+
+    def serializes_without_callbacks(self, node):
+        """Only a closed source proof can admit non-primitive JSON traversal."""
+        return self.closed and self._serializable(node)
+
+    def _serializable(self, initial):
+        """Bound JSON traversal to immutable plain records and native arrays.
+
+        JSON.stringify may execute toJSON/accessors while visiting its input.
+        A string result alone therefore supplies no operand-effect evidence.
+        Member writes are excluded by the closed-source proof; empty private
+        arrays additionally include every value stored by their native push.
+        """
+        if self._storage_values is None:
+            self._storage_values = {}
+            for candidate in self.nodes:
+                self.step()
+                if candidate.type == "call_expression":
+                    definition = self._storage_definition(self.field(candidate, "function"))
+                    if definition is not None:
+                        self._storage_values.setdefault(definition.id, []).extend(
+                            self.children(self.field(candidate, "arguments"))
+                        )
+        pending = [initial]
+        visited = set()
+        while pending:
+            self.step()
+            node = pending.pop()
+            if node is None:
+                return False
+            if node.id in visited:
+                continue
+            visited.add(node.id)
+            kind = self.kind(node)
+            if self.primitive(kind):
+                continue
+            if node.type in {"parenthesized_expression", "await_expression"}:
+                values = self.children(node)
+                if len(values) != 1:
+                    return False
+                pending.extend(values)
+            elif node.type in {"identifier", "shorthand_property_identifier"}:
+                definition = self.definition(node)
+                if definition is None or self._writes.get(definition.id):
+                    return False
+                value = self.const_value(definition)
+                if value is None:
+                    return False
+                pending.append(value)
+                pending.extend(self._storage_values.get(definition.id, []))
+            elif node.type == "object":
+                for child in self.children(node):
+                    self.step()
+                    if child.type == "shorthand_property_identifier":
+                        pending.append(child)
+                    elif child.type == "pair":
+                        key = self.field(child, "key")
+                        if (
+                            key is None
+                            or key.type not in {"property_identifier", "string", "number"}
+                            or "\\" in self.text(key)
+                            or self.text(key).strip("\"'") in {"__proto__", "toJSON"}
+                        ):
+                            return False
+                        pending.append(self.field(child, "value"))
+                    else:
+                        return False
+            elif node.type == "array":
+                values = self.children(node)
+                if any(value.type == "spread_element" for value in values):
+                    return False
+                pending.extend(values)
+            elif kind is not None and kind[0] == "array" and self.primitive(kind[1]):
+                continue
+            elif node.type == "call_expression":
+                function = self.private_function(self.field(node, "function"))
+                if function is None:
+                    return False
+                returns = []
+                for candidate in self.nodes:
+                    self.step()
+                    if candidate.type != "return_statement":
+                        continue
+                    owner = self.parent(candidate)
+                    while owner is not None and owner.type not in {
+                        "function_declaration", "arrow_function", "function_expression"
+                    }:
+                        self.step()
+                        owner = self.parent(owner)
+                    if owner == function:
+                        values = self.children(candidate)
+                        if len(values) != 1:
+                            return False
+                        returns.extend(values)
+                if not returns:
+                    return False
+                pending.extend(returns)
+            else:
+                return False
+        return True
+
+    def verify_callback_uses(self, data_use):
+        """Close the effect proof after the value owner is available to its graph."""
+        self._data_use = data_use
+        if self.closed:
+            for node in self.nodes:
+                self.step()
+                if node.type == "arrow_function" and not self._callback_uses_are_data(node):
+                    self.closed = False
+                    return
+
+    def _callback_uses_are_data(self, callback):
+        self.step()
+        if callback.id in self._callback_cache:
+            return self._callback_cache[callback.id]
+        if callback.id in self._callback_active or self._data_use is None:
+            return False
+        self._callback_active.add(callback.id)
+        try:
+            parameters = self.children(self.field(callback, "parameters"))
+            parameter = self.field(callback, "parameter")
+            if parameter is not None:
+                parameters.append(parameter)
+            result = False
+            if len(parameters) == 1 and not self._writes.get(parameters[0].id):
+                body = self.field(callback, "body")
+                result = body is not None and all(
+                    self._data_use(read, boundary=body) for read in self.reads(parameters[0])
+                )
+            self._callback_cache[callback.id] = result
+            return result
+        finally:
+            self._callback_active.remove(callback.id)
+
+    def method(self, function):
+        if not self.closed or function is None or function.type != "member_expression":
+            return False
+        call = self.parent(function)
+        if call is None or call.type != "call_expression" or self.kind(call) is None:
+            return False
+        member = self.field(function, "property")
+        if member is not None and self.text(member) in {"map", "filter"}:
+            arguments = self.children(self.field(call, "arguments"))
+            return len(arguments) == 1 and self._callback_uses_are_data(arguments[0])
+        return True
+
+    def storage(self, function):
+        return self._storage_definition(function) if self.closed and function is not None else None
+
+    def argument_use(self, call, index):
+        """Distinguish terminal output from native results retaining input data."""
+        if not self.closed:
+            return None
+        function = self.field(call, "constructor" if call.type == "new_expression" else "function")
+        cap = self.capability(function)
+        args = self.children(self.field(call, "arguments"))
+        if function is not None and function.type == "member_expression":
+            receiver = self.kind(self.field(function, "object"))
+            member = self.field(function, "property")
+            # These exact typed native methods consume their arguments as
+            # scalar data. Storage and callback methods need their own use
+            # graph, so a primitive result alone never admits their inputs.
+            scalar_method = receiver is not None and (
+                receiver[0] in {"string", "number", "regexp"}
+                or (receiver[0] == "array" and member is not None and self.text(member) == "join")
+            )
+            if scalar_method and 0 <= index < len(args):
+                return "result" if self._method_kind(function, args) is not None else None
+        if index != 0:
+            return None
+        if cap == ("ambient", "RegExp"):
+            return "result" if self.kind(call) == ("regexp",) else None
+        if args and self.primitive(self.kind(args[0]), error=True):
+            if cap == ("ambient", "String"):
+                return "result"
+            if cap in {("ambient", "console.log"), ("ambient", "console.error")}:
+                return "terminal"
+        return None
