+                # contracts. Only the existing single-scalar output is owned.
+                if len(args) != 1 or not self.primitive(self.kind(args[0]), error=True):
+                    return False
+                continue
+            if cap == ("ambient", "process.exit"):
+                if len(args) > 1 or any(not self.primitive(self.kind(arg)) for arg in args):
+                    return False
+                continue
+            if cap == ("ambient", "Array.isArray"):
+                if len(args) != 1:
+                    return False
+                continue
+            if cap == ("ambient", "Math.abs"):
