+            diagnostic_values = DiagnosticTemplateValues(
+                data=data, nodes=nodes, parents=parents, definition=data_definition,
+                capability=capability, private_function=local_function, reads=value_reads,
+                bindings=bindings, ambient_intrinsic=ambient_intrinsic, step=step,
+            )
