+                {"/Type", "/Subtype", "/BaseFont", "/Encoding", "/Name"},
+                {"/Type", "/Subtype", "/BaseFont"},
+            )
+            name(value.Type, {"/Font"})
+            name(value.Subtype, {"/Type1"})
+            name(value.BaseFont, {"/Helvetica"})
+            if "/Encoding" in value:
