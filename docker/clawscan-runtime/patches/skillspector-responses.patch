+    text.append("".join(continuous_glyphs))
+    return text
+
+
+def _child() -> None:
+    try:
+        import resource
+
+        resource.setrlimit(resource.RLIMIT_AS, (512 * 1024 * 1024, 512 * 1024 * 1024))
+        resource.setrlimit(resource.RLIMIT_CPU, (3, 3))
+        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+        resource.setrlimit(resource.RLIMIT_FSIZE, (0, 0))
+        resource.setrlimit(resource.RLIMIT_NOFILE, (64, 64))
+        data = sys.stdin.buffer.read(MAX_PDF_BYTES + 1)
+        if len(data) > MAX_PDF_BYTES:
+            raise UnsupportedPdfError
+        text = _decode_passive(data)
+        result = json.dumps(
+            {"sha256": hashlib.sha256(data).hexdigest(), "text": text}, ensure_ascii=True
+        )
+        if len(result.encode()) > MAX_PDF_VIEW_BYTES:
+            raise UnsupportedPdfError
+        sys.stdout.write(result)
+    except Exception:
+        sys.exit(1)
+
+
+def inspect_pdf(data: bytes, *, timeout_seconds: float) -> PdfInspection:
+    if sys.platform != "linux":
+        return PdfInspection(None, "opaque_content")
+    if len(data) > MAX_PDF_BYTES:
+        return PdfInspection(None, "size_limit")
+    if timeout_seconds <= 0:
+        return PdfInspection(None, "runtime_limit")
+    try:
+        result = subprocess.run(
+            [sys.executable, "-I", "-B", str(Path(__file__).resolve()), "--child"],
+            input=data,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL,
+            timeout=min(MAX_PDF_SECONDS, timeout_seconds),
+            env={"LANG": "C.UTF-8"},
+            check=False,
+        )
+        if result.returncode or len(result.stdout) > MAX_PDF_VIEW_BYTES:
+            return PdfInspection(None, "opaque_content")
+        decoded = json.loads(result.stdout)
+        if not isinstance(decoded, dict) or set(decoded) != {"sha256", "text"}:
+            raise ValueError
+        if decoded["sha256"] != hashlib.sha256(data).hexdigest():
+            raise ValueError
+        if not isinstance(decoded["text"], list) or not all(
+            isinstance(item, str) for item in decoded["text"]
+        ):
+            raise ValueError
+        from skillspector.artifacts import binary_instruction_view, decode_text
+
+        raw_view, truncated = binary_instruction_view(decode_text(data))
+        if truncated:
+            return PdfInspection(None, "size_limit")
+        view = json.dumps(
+            {
+                "format": "bounded-passive-pdf-v1",
+                "source_sha256": decoded["sha256"],
+                "text": decoded["text"],
+                "raw_printable": raw_view.text,
+            },
+            ensure_ascii=True,
+            separators=(",", ":"),
+        )
+        if len(view.encode()) > MAX_PDF_VIEW_BYTES:
+            return PdfInspection(None, "size_limit")
+        return PdfInspection(view)
+    except subprocess.TimeoutExpired:
+        return PdfInspection(None, "runtime_limit")
+    except (OSError, ValueError, TypeError, RecursionError):
+        return PdfInspection(None, "opaque_content")
+
+
+if __name__ == "__main__":
+    _child()
