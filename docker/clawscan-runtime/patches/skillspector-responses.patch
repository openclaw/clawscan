+            start, end = starts[start_line], starts[end_line]
+            # Preserve the existing shell projection's stricter table
+            # boundaries when the optional canonical parser disagrees.
+            if any(
+                source_offsets[start] < excluded_end and excluded_start < source_offsets[end]
