+    def _closed_source(self):
+        for node in self.nodes:
+            self.step()
+            if not self._operands_are_data(node):
+                return False
+            if node.type in {
+                "assignment_expression",
+                "augmented_assignment_expression",
+                "update_expression",
+                "for_in_statement",
+            }:
+                target = self.field(node, "left") or self.field(node, "argument")
+                for binding_target in self.bindings(target, assignment=True):
+                    # Fresh records can acquire serialization/coercion hooks
+                    # through ordinary field writes and aliases as well.
+                    if binding_target.type in {"member_expression", "subscript_expression"}:
+                        return False
+                    if (
+                        binding_target.type in {"identifier", "shorthand_property_identifier_pattern"}
+                        and self.definition(binding_target) is None
+                    ):
+                        return False
+            cap = self.capability(node)
+            if cap is not None and self._existing_capability(node) is None:
+                owner = self.parent(node)
+                if owner is None:
+                    return False
+                alias = (
+                    owner.type == "variable_declarator"
+                    and self.field(owner, "value") == node
+                    and self.const_value(self.field(owner, "name")) is not None
+                )
+                receiver = owner.type == "member_expression" and self.field(owner, "object") == node
+                invoked = owner.type in {"call_expression", "new_expression"} and (
+                    self.field(owner, "function") == node
+                    or self.field(owner, "constructor") == node
+                )
+                callback = False
+                if (
+                    cap == ("ambient", "Boolean")
+                    and owner.type == "arguments"
+                    and self.children(owner) == [node]
+                ):
+                    call = self.parent(owner)
+                    function = self.field(call, "function")
+                    member = self.field(function, "property")
+                    callback = (
+                        function is not None
+                        and function.type == "member_expression"
+                        and member is not None
+                        and self.text(member) == "find"
+                    )
+                if not (alias or receiver or invoked or callback):
+                    return False
+            if node.type in {
+                "export_statement",
+                "class",
+                "class_declaration",
+                "method_definition",
+                "field_definition",
+                "function_expression",
+                "generator_function",
+                "generator_function_declaration",
+            }:
+                return False
+            if node.type == "function_declaration":
+                name = self.field(node, "name")
+                if (
+                    name is None
+                    or self.private_function(name) != node
+                    or any(c.type == "async" for c in node.children)
+                ):
+                    return False
+            if node.type == "arrow_function":
+                parameter = self.field(node, "parameter")
+                parameters = self.children(self.field(node, "parameters"))
+                if parameter is not None:
+                    parameters.append(parameter)
+                if len(parameters) != 1 or self._callback_parameter(node, parameters[0]) is None:
+                    return False
+            if node.type == "throw_statement":
+                values = self.children(node)
+                if len(values) != 1 or not self.primitive(self.kind(values[0]), error=True):
+                    return False
+            if node.type not in {"call_expression", "new_expression"}:
+                continue
+            function = self.field(
+                node, "constructor" if node.type == "new_expression" else "function"
+            )
+            cap = self.capability(function)
+            if node.type == "new_expression":
+                if cap != ("ambient", "RegExp") or self.kind(node) != ("regexp",):
+                    return False
+                continue
+            if function is not None and self.private_function(function) is not None:
+                continue
