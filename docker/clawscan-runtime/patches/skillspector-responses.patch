+"""Bounded native value typing for closed, private validator functions.
+
+This supplies use/type evidence to the existing value graph. It grants no source
+ranges itself. Unknown calls, deferred functions, exports and mutable identities
+disable the optional proof rather than dropping an authored construction.
+"""
+
+
+def json_call_has_inert_options(capability, arguments):
+    """Optional JSON arguments must not introduce dispatch or argument shifts."""
+    if capability not in {("ambient", "JSON.stringify"), ("ambient", "JSON.parse")}:
+        return False
+    if not 1 <= len(arguments) <= 3 or any(
+        argument.type == "spread_element" for argument in arguments
+    ):
+        return False
+    if len(arguments) == 1:
+        return True
+    return (
+        capability == ("ambient", "JSON.stringify")
+        and len(arguments) in {2, 3}
+        and arguments[1].type == "null"
+        and (len(arguments) == 2 or arguments[2].type == "number")
+    )
+
+
+class NativeValidatorValues:
+    _INTRINSICS = {"Number", "Boolean", "RegExp", "console"}
+    # These forms introduce no implicit user-code dispatch of their own. Their
+    # children are visited separately, and declarations/calls/functions receive
+    # the additional identity/use checks in _closed_source. Unlisted grammar
+    # forms disable this optional proof rather than inheriting a default True.
+    _STRUCTURAL_NODES = {
+        "arguments", "array", "arrow_function", "assignment_expression",
+        "break_statement", "catch_clause", "comment", "continue_statement",
+        "else_clause", "empty_statement", "escape_sequence", "expression_statement",
+        "false", "finally_clause", "for_statement", "formal_parameters",
+        "function_declaration", "hash_bang_line", "identifier", "if_statement",
+        "import_clause", "import_specifier", "import_statement", "lexical_declaration",
+        "named_imports", "namespace_import", "null", "number", "object",
+        "optional_chain", "pair", "parenthesized_expression", "program",
+        "property_identifier", "regex", "regex_flags", "regex_pattern",
+        "return_statement", "sequence_expression", "shorthand_property_identifier",
+        "statement_block", "string", "string_fragment", "template_string",
+        "ternary_expression", "throw_statement", "true", "try_statement",
+        "variable_declarator",
+    }
+    _BINARY_OPERATORS = {
+        "??", "||", "&&", "===", "!==", "==", "!=", "<", ">", "<=", ">=",
+        "-", "*", "/", "%", "+", "**", "<<", ">>", ">>>", "&", "|", "^",
+    }
+    _AUGMENTED_OPERATORS = {
+        "??=", "||=", "&&=", "+=", "-=", "*=", "/=", "%=", "**=",
+        "<<=", ">>=", ">>>=", "&=", "|=", "^=",
+    }
+
+    def __init__(
+        self, *, data, nodes, parents, definition, capability, private_function, reads,
+        bindings, ambient_intrinsic, step
+    ):
+        self.data = data
+        self.nodes = nodes
+        self.parents = parents
+        self.definition = definition
+        self._existing_capability = capability
+        self.private_function = private_function
+        self.reads = reads
+        self.bindings = bindings
+        self.ambient_intrinsic = ambient_intrinsic
+        self.step = step
+        self._cache = {}
+        self._active = set()
+        self._writes = {}
+        self._callback_cache = {}
+        self._callback_active = set()
+        self._storage_values = None
+        self._data_use = None
+        for node in nodes:
+            step()
+            if node.type not in {
+                "assignment_expression",
+                "augmented_assignment_expression",
+                "update_expression",
+                "for_in_statement",
+            }:
+                continue
+            target = self.field(node, "left") or self.field(node, "argument")
+            if node.type == "for_in_statement" and any(
+                child.type in {"const", "let", "var"} for child in node.children
+            ):
+                continue
+            for binding_target in bindings(target, assignment=True):
+                if binding_target.type in {"identifier", "shorthand_property_identifier_pattern"}:
+                    binding = definition(binding_target)
+                    if binding is not None:
+                        self._writes.setdefault(binding.id, []).append(node)
+        self.closed = False
+        self.closed = self._closed_source()
+
+    def capability(self, node, visiting=frozenset()):
+        if node is None or node.id in visiting or len(visiting) >= 64:
+            return None
+        self.step()
+        existing = self._existing_capability(node)
+        if existing is not None:
+            return existing
+        visiting = visiting | {node.id}
+        if node.type == "identifier":
+            definition = self.definition(node)
+            if definition is None:
+                return self.ambient_intrinsic(node, self._INTRINSICS)
+            if self._writes.get(definition.id):
+                return None
+            value = self.const_value(definition)
+            return self.capability(value, visiting) if value is not None else None
+        if node.type == "member_expression":
+            base = self.capability(self.field(node, "object"), visiting)
+            member = self.field(node, "property")
+            if base is not None and member is not None and member.type == "property_identifier":
+                if base[0] == "ambient" and base[1].split(".")[0] in self._INTRINSICS:
+                    return ("ambient", base[1] + "." + self.text(member))
+                if base == ("ambient", "process") and self.text(member) == "exit":
+                    return ("ambient", "process.exit")
+        return None
+
+    def text(self, node):
+        return self.data[node.start_byte : node.end_byte].decode("utf-8")
+
+    def parent(self, node):
+        return self.parents.get(node.id)
+
+    @staticmethod
+    def field(node, name):
+        return node.child_by_field_name(name) if node is not None else None
+
+    @staticmethod
+    def children(node):
+        return [c for c in node.named_children if c.type != "comment"] if node is not None else []
+
+    def const_value(self, definition):
+        owner = self.parent(definition)
+        declaration = self.parent(owner) if owner is not None else None
+        if owner is None or owner.type != "variable_declarator" or declaration is None:
+            return None
+        if declaration.type != "lexical_declaration" or not self.text(declaration).startswith(
+            "const"
+        ):
+            return None
+        return self.field(owner, "value")
+
+    def kind(self, node):
+        if node is None:
+            return None
+        self.step()
+        if node.id in self._cache:
+            return self._cache[node.id]
+        if node.id in self._active or len(self._active) >= 64:
+            return None
+        self._active.add(node.id)
+        try:
+            value = self._kind(node)
+            self._cache[node.id] = value
+            return value
+        finally:
+            self._active.remove(node.id)
+
+    def _same_kind(self, left, right):
+        # Cached kinds form a DAG. Neither nested tuple equality nor tuple
+        # hashing charges the caller's budget or reuses a shared subgraph.
+        pending = [(left, right)]
+        visited = set()
+        while pending:
+            self.step()
+            left, right = pending.pop()
+            if left is right:
+                continue
+            if not isinstance(left, tuple) or not isinstance(right, tuple):
+                if left != right:
+                    return False
+                continue
+            if len(left) != len(right):
+                return False
+            pair = (id(left), id(right))
+            if pair in visited:
+                continue
+            visited.add(pair)
+            pending.extend(zip(left, right, strict=True))
+        return True
+
+    def primitive(self, kind, *, error=False):
+        allowed = (
+            {"string", "number", "boolean", "null", "error"}
+            if error
+            else {"string", "number", "boolean", "null"}
+        )
+        pending = [kind]
+        visited = set()
+        while pending:
+            self.step()
+            value = pending.pop()
+            if value is None:
+                return False
+            if id(value) in visited:
+                continue
+            visited.add(id(value))
+            if value[0] == "either":
+                pending.extend(value[1:])
+            elif value[0] not in allowed:
+                return False
+        return True
+
+    def _kind(self, node):
+        t = node.type
+        if t in {"string", "template_string"}:
+            return ("string",)
+        if t == "number":
+            return ("number",)
+        if t in {"true", "false"}:
+            return ("boolean",)
+        if t == "null":
+            return ("null",)
+        if t == "regex":
+            return ("regexp",)
+        if t in {"parenthesized_expression", "await_expression"}:
+            children = self.children(node)
+            return self.kind(children[0]) if len(children) == 1 else None
+        if t in {"identifier", "shorthand_property_identifier"}:
+            definition = self.definition(node)
+            if definition is None:
+                return None
+            writes = self._writes.get(definition.id, [])
+            if writes:
+                owner = self.parent(definition)
+                declaration = self.parent(owner) if owner is not None else None
+                if (
+                    owner is None
+                    or owner.type != "variable_declarator"
+                    or declaration is None
+                    or not self.text(declaration).startswith("let")
+                    or self.kind(self.field(owner, "value")) != ("number",)
+                ):
+                    return None
+                for write in writes:
+                    self.step()
+                    op = self.field(write, "operator")
+                    if (
+                        write.type == "update_expression"
+                        and op is not None
+                        and self.text(op) in {"++", "--"}
+                    ):
+                        continue
+                    if (
+                        write.type == "augmented_assignment_expression"
+                        and op is not None
+                        and self.text(op) in {"+=", "-="}
+                        and self.kind(self.field(write, "right")) == ("number",)
