+            else:
+                raise OwnershipBudgetExceededError
+
+    for node in nodes:
+        step()
+        if node.type in {"with_statement", "this"} or (
+            node.type == "method_definition"
+            and any(c.type in {"get", "set"} for c in node.children)
+        ):
+            if not opaque_only:
+                return None
+        if node.type in {
+            "identifier",
+            "property_identifier",
+            "shorthand_property_identifier",
+            "shorthand_property_identifier_pattern",
+        } and "\\" in data[node.start_byte : node.end_byte].decode("utf-8"):
+            # Escaped spellings have the same runtime binding identity. This
+            # bounded slice abstains rather than comparing raw spellings.
+            if not opaque_only:
+                return None
+        if node.type in {
+            "identifier",
+            "shorthand_property_identifier",
+            "shorthand_property_identifier_pattern",
+        }:
+            references[text(node)].append(node)
+        if node.type == "variable_declarator":
+            for name in bindings(field(node, "name")):
+                definitions[text(name)].append(name)
+        if node.type == "for_in_statement" and any(
+            c.type in {"const", "let", "var"} for c in node.children
+        ):
+            for name in bindings(field(node, "left")):
+                definitions[text(name)].append(name)
+        if node.type in {
+            "function_declaration",
+            "generator_function_declaration",
+            "function_expression",
+            "generator_function",
+            "class_declaration",
+            "class",
+        }:
+            name = field(node, "name")
+            if name is not None:
+                for binding in bindings(name):
+                    definitions[text(binding)].append(binding)
+        if node.type in {"formal_parameters", "catch_clause"}:
+            target = field(node, "parameter") if node.type == "catch_clause" else node
+            if target is not None:
+                for name in bindings(target):
+                    definitions[text(name)].append(name)
+        if node.type == "arrow_function":
+            name = field(node, "parameter")
+            if name is not None:
+                for binding in bindings(name):
+                    definitions[text(binding)].append(binding)
+        if node.type == "import_statement":
+            source = field(node, "source")
+            module = text(source)[1:-1] if source is not None else ""
+            supported = module in _NATIVE_MODULES and "\\" not in module
+            if not supported and not opaque_only:
+                return None
+            stack = list(node.named_children)
+            while stack:
+                child = stack.pop()
+                if child.type == "import_specifier":
+                    original = field(child, "name")
+                    local = field(child, "alias") or original
+                    if original is None or local is None:
+                        return None
+                    definitions[text(local)].append(local)
+                    if supported:
+                        imported[local.id] = (module, text(original))
+                elif child.type in {"namespace_import", "import_clause"}:
+                    local_names = [c for c in child.named_children if c.type == "identifier"]
+                    if local_names and not opaque_only:
+                        return None
+                    for local in local_names:
+                        definitions[text(local)].append(local)
+                        if supported:
+                            imported[local.id] = (module, "")
+                    stack.extend(c for c in child.named_children if c.type != "identifier")
+                elif child.type != "string":
+                    stack.extend(child.named_children)
+
+    scope_cache = {}
+    definition_cache = {}
+
+    def function_scope(initial):
+        if initial.id in scope_cache:
+            return scope_cache[initial.id]
+        node = parent(initial)
+        while node is not None and node.type not in {
+            "program",
+            "function_declaration",
+            "function_expression",
+            "arrow_function",
+            "generator_function_declaration",
+            "generator_function",
+            "method_definition",
+        }:
+            step()
+            node = parent(node)
+        scope_cache[initial.id] = node
+        return node
+
+    lexical_scopes = {
+        "program",
+        "statement_block",
+        "switch_body",
+        "catch_clause",
+        "for_statement",
+        "for_in_statement",
+        "function_declaration",
+        "function_expression",
+        "arrow_function",
+        "generator_function_declaration",
+        "generator_function",
+        "method_definition",
+    }
+    binding_scope_cache = {}
+
+    def binding_scope(definition):
+        if definition.id in binding_scope_cache:
+            return binding_scope_cache[definition.id]
+        owner = parent(definition)
+        while owner is not None and owner.type in {
+            "object_pattern",
+            "array_pattern",
+            "pair_pattern",
+            "assignment_pattern",
+            "object_assignment_pattern",
+            "rest_pattern",
+        }:
+            owner = parent(owner)
+        if owner is not None and owner.type == "formal_parameters":
+            result = function_scope(definition)
+        elif owner is not None and owner.type == "catch_clause":
+            result = owner
+        elif (
+            owner is not None
+            and owner.type == "for_in_statement"
+            and any(c.type == "var" for c in owner.children)
+        ):
+            result = function_scope(definition)
+        elif (
+            owner is not None
+            and owner.type == "variable_declarator"
+            and parent(owner).type != "lexical_declaration"
+        ):
+            result = function_scope(definition)
+        else:
+            # Function declarations bind in their surrounding block, unlike
+            # parameters and named function expressions.
+            cursor = (
+                parent(owner)
+                if owner is not None
+                and owner.type in {"function_declaration", "generator_function_declaration"}
+                else owner
+            )
+            while cursor is not None and cursor.type not in lexical_scopes:
+                step()
+                cursor = parent(cursor)
+            result = cursor
+        binding_scope_cache[definition.id] = result
+        return result
+
+    lexical_definition_cache = {}
+
+    def lexical_definitions(reference):
+        if reference.id in lexical_definition_cache:
+            step()
+            return lexical_definition_cache[reference.id]
+        cursor = parent(reference)
+        while cursor is not None:
+            step()
+            if cursor.type in lexical_scopes:
+                matches = [n for n in definitions[text(reference)] if binding_scope(n) == cursor]
+                if matches:
+                    lexical_definition_cache[reference.id] = matches
+                    return matches
+            cursor = parent(cursor)
+        lexical_definition_cache[reference.id] = []
+        return []
+
+    def data_definition(reference):
+        if reference.id not in definition_cache:
+            matches = lexical_definitions(reference)
+            definition_cache[reference.id] = matches[0] if len(matches) == 1 else None
+        return definition_cache[reference.id]
+
+    def scope_encloses(scope, reference):
+        cursor = parent(reference)
+        while cursor is not None:
+            step()
+            if cursor == scope:
+                return True
+            cursor = parent(cursor)
+        return False
+
+    def ambient_intrinsic(node, names):
+        """Resolve ambient names with the same lexical and Annex B boundary."""
+        step()
+        if node is None or node.type not in {
+            "identifier", "shorthand_property_identifier", "shorthand_property_identifier_pattern"
+        }:
+            return None
+        name = text(node)
+        if name not in names or lexical_definitions(node) or unsafe_native:
+            return None
+        for definition in definitions[name]:
+            step()
+            owner = parent(definition)
+            if (
+                owner is not None
+                and owner.type == "function_declaration"
+                and binding_scope(definition) != function_scope(owner)
+                and scope_encloses(function_scope(owner), node)
+            ):
+                return None
+        return ("ambient", name)
+
+    def capability(node, visiting=frozenset()):
+        step()
+        if node is None or node.id in visiting or len(visiting) > 128:
+            return None
+        visiting = visiting | {node.id}
+        if node.type in {
+            "identifier",
+            "shorthand_property_identifier",
+            "shorthand_property_identifier_pattern",
+        }:
+            name = text(node)
+            defs = lexical_definitions(node)
+            if name in _GLOBAL_CAPABILITIES and not defs:
+                return ambient_intrinsic(node, _GLOBAL_CAPABILITIES)
+            if len(defs) != 1:
+                return None
+            if defs[0].id in imported:
+                return imported[defs[0].id] if not unsafe_native else None
+            owner = parent(defs[0])
+            if (
+                owner is not None
+                and owner.type == "variable_declarator"
+                and const_declaration(owner)
+            ):
+                return capability(field(owner, "value"), visiting)
+            return None
+        if node.type == "member_expression":
+            base = capability(field(node, "object"), visiting)
+            member = field(node, "property")
+            if base is not None and member is not None and member.type == "property_identifier":
+                result = (base[0], ".".join(part for part in (base[1], text(member)) if part))
+                if (
+                    base[0] == "ambient"
+                    and base[1].startswith("process")
+                    and result[1]
+                    not in {
+                        "process.stdout",
+                        "process.stderr",
+                        "process.stdout.write",
+                        "process.stderr.write",
+                        "process.exitCode",
+                        "process.getBuiltinModule",
+                        "process.argv",
+                        "process.argv.slice",
+                    }
+                ):
