+            dictionary(value, {"/Type", "/Pages", "/PageMode"}, {"/Type", "/Pages"})
+            name(value.Type, {"/Catalog"})
+            if "/PageMode" in value:
+                name(value.PageMode, {"/UseNone"})
+            visit(value.Pages, "pages", depth + 1)
+        elif role == "pages":
+            dictionary(value, {"/Type", "/Count", "/Kids"}, {"/Type", "/Count", "/Kids"})
+            name(value.Type, {"/Pages"})
+            array(value.Kids)
+            if type(value.Count) is not int or value.Count != len(value.Kids):
+                raise UnsupportedPdfError
+            page_ids = [page.objgen for page in value.Kids]
+            if (0, 0) in page_ids or len(set(page_ids)) != len(page_ids):
+                raise UnsupportedPdfError
+            for page in value.Kids:
