+                    outer = parent(consumer)
+                    if (
+                        method is not None
+                        and text(method) == "catch"
+                        and outer is not None
+                        and outer.type == "call_expression"
+                        and field(outer, "function") == consumer
+                    ):
+                        consumer = parent(outer)
+                        if consumer is not None and consumer.type in {
+                            "await_expression", "expression_statement"
+                        }:
