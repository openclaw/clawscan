+            "ambient",
+            "Object.assign",
+        ):
+            arguments = field(node, "arguments")
+            if arguments is None or not semantic_children(arguments):
+                if not opaque_only:
+                    return None
+            target = semantic_children(arguments)[0]
+            native_error = target.type == "new_expression" and capability(
+                field(target, "constructor")
+            ) == ("ambient", "Error")
+            if not native_error and not fresh_record_roots(target):
+                unsafe_native = True
+                if not opaque_only:
+                    return None
+
+    def diagnostic_template_is_data(node):
+        nonlocal diagnostic_values
+        if unsafe_native:
+            return False
+        arguments = parent(node)
+        call = parent(arguments) if arguments is not None else None
+        function = field(call, "function") if call is not None else None
+        if function is None or function.type != "member_expression":
+            return False
+        receiver, member = field(function, "object"), field(function, "property")
+        if receiver is None or receiver.type != "identifier" or text(receiver) != "console":
+            return False
+        if member is None or text(member) not in {"log", "error"}:
+            return False
+        if diagnostic_values is None:
