+    nodes, parents = [], {}
+    count = 0
+    while pending:
+        node, depth, owner = pending.pop()
+        nodes.append(node)
+        parents[node.id] = owner
+        count += 1
+        if count > MAX_NODES or depth > MAX_DEPTH:
+            return None
+        if count % 128 == 0:
+            check_runtime()
+        if node.type == "comment":
+            start, end = node.start_byte, node.end_byte
+            raw = data[start:end]
+            if not (raw.startswith(b"//") or (raw.startswith(b"/*") and raw.endswith(b"*/"))):
+                return None
+            comments.append((start, end))
+        pending.extend((child, depth + 1, node) for child in node.children)
+    try:
+        proof = data_literal_ranges(data, nodes, parents, check_runtime)
+    except OwnershipBudgetExceededError:
+        return None
+    if proof is None:
+        # No ownership is admitted after a failed identity proof. A separate
+        # pass still follows authored constructions to actual call arguments;
+        # unsupported imports and unobserved exports alone add no opacity.
+        comments = []
+        try:
+            fallback = data_literal_ranges(data, nodes, parents, check_runtime, opaque_only=True)
+        except OwnershipBudgetExceededError:
+            return None
+        if fallback is None:
+            return None
+        literals, unsupported = fallback
+    else:
+        literals, unsupported = proof
