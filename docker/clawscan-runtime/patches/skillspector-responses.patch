+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""Optional closing-delimiter proof for complete comma-separated data."""
+
+from __future__ import annotations
+
+import csv
+import io
+from collections.abc import Callable
+
+
+def _closing_quotes(content: str, check_runtime: Callable[[], None]) -> frozenset[int]:
+    check_runtime()
+    if not content or len(content) > 1_048_576 or "\x00" in content:
+        return frozenset()
+    # Bound allocation before asking the canonical parser to create rows/cells.
+    # The lexer also maps every canonical field back to exact source characters.
+    rows: list[list[str]] = []
+    row: list[str] = []
+    closers: set[int] = set()
+    cursor = 0
+    fields = 0
+    while True:
+        check_runtime()
+        fields += 1
+        if fields > 8192:
+            return frozenset()
+        quoted = cursor < len(content) and content[cursor] == '"'
+        cursor += int(quoted)
+        start = cursor
+        while cursor < len(content):
+            if cursor % 4096 == 0:
+                check_runtime()
+            char = content[cursor]
+            if quoted and char == '"':
+                if content.startswith('""', cursor):
+                    cursor += 2
+                    continue
+                break
+            if not quoted and char in ',\r\n':
+                break
+            cursor += 1
+        if quoted:
+            if cursor >= len(content):
+                return frozenset()
+            row.append(content[start:cursor].replace('""', '"'))
+            closers.add(cursor)
+            cursor += 1
+        else:
+            row.append(content[start:cursor])
+        if cursor < len(content) and content[cursor] == ',':
+            cursor += 1
+            continue
+        if cursor < len(content):
+            if content[cursor] == '\r' and content.startswith('\r\n', cursor):
+                cursor += 2
+            elif content[cursor] == '\n':
+                cursor += 1
+            else:
+                return frozenset()
+        rows.append(row)
+        row = []
+        if cursor >= len(content):
+            break
+    if len(rows) < 2 or len(rows[0]) < 2:
+        return frozenset()
+    check_runtime()
+    try:
+        canonical = list(csv.reader(io.StringIO(content, newline=""), strict=True))
+    except csv.Error:
+        return frozenset()
+    check_runtime()
+    return frozenset(closers) if canonical == rows else frozenset()
+
+
+class CSVStringClosers:
+    """Prove structural closing quotes while retaining every field-body byte.
+
+    Only complete comma-separated documents with at least two rows and a
+    multi-column first row qualify; ragged rows retain their canonical meaning. Fragments, other dialects, uncertain source mappings and
+    budget exhaustion grant no ownership. Explicit marker instructions are still
+    parsed inside every field by the caller.
+    """
+
+    def __init__(self, content: str, check_runtime: Callable[[], None]) -> None:
+        self._content = content
+        self._check_runtime = check_runtime
+        self._closers: frozenset[int] | None = None
+
+    def closes_string(self, offset: int) -> bool:
+        if self._closers is None:
+            self._closers = _closing_quotes(self._content, self._check_runtime)
+        self._check_runtime()
+        return offset in self._closers
