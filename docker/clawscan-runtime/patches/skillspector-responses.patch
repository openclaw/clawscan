+
+class MarkdownCodeSpanClosers:
+    """Prove closing backticks without hiding the contents of a code span.
+
+    A block's inline source must map uniquely and verbatim to the original
+    text. Containers that remove prefixes from continuation lines, escaped
+    delimiters, uncertain mappings and oversized documents grant no ownership.
+    Tables, fenced/indented code and raw HTML never grant inline ownership.
+    """
+
+    def __init__(self, content: str, check_runtime: Callable[[], None]):
+        self._closers: set[int] = set()
+        check_runtime()
+        # This optional proof only refines the existing lexical fallback. If
+        # unavailable, preserve that fallback rather than asserting coverage.
+        if len(content) > 1_048_576:
+            return
+        # CommonMark normalizes physical newlines before inline parsing. Keep
+        # an exact map back to raw characters; the artifact is never rewritten.
+        source_offsets = array("I")
+        normalized = []
+        cursor = 0
+        while cursor < len(content):
+            if cursor % 4096 == 0:
+                check_runtime()
+            char = content[cursor]
+            source_offsets.append(cursor)
+            normalized.append("\n" if char == "\r" else char)
+            cursor += 2 if content.startswith("\r\n", cursor) else 1
+        content = "".join(normalized)
+        parser = MarkdownIt("commonmark").enable("table")
+        # Observe the original document parse, including its reference-link
+        # environment. Each nested image state has a distinct source object;
+        # keep strong source references so identities cannot be reused.
+        records: dict[int, tuple[str, set[int]]] = {}
+
+        def record_backtick(state, silent):
+            check_runtime()
+            before = len(state.tokens)
+            matched = backtick(state, silent)
+            if matched and not silent and len(state.tokens) > before:
+                token = state.tokens[-1]
+                if token.type == "code_inline":
+                    _, closers = records.setdefault(id(state.src), (state.src, set()))
+                    closers.update(
+                        i for i in range(state.pos - len(token.markup), state.pos)
+                        if state.src[i] == "`"
+                    )
+            return matched
+
+        parser.inline.ruler.at("backticks", record_backtick)
+        # GFM tables can synthesize many empty cells from very little source.
+        # Enforce one shared document-wide budget BEFORE block or inline token
+        # allocation, including nested states and pending-text tokens. Inline
+        # emphasis/delimiter expansion can amplify source just as tables do.
+        class OwnershipBudgetExceeded(Exception):
+            pass
+
+        remaining_tokens = 8192
+
+        def install_allocation_budget(state):
+            if getattr(state, "_ownership_budgeted", False):
+                return
+            original_push = state.push
+            original_pending = getattr(state, "pushPending", None)
+
+            def consume_token():
+                nonlocal remaining_tokens
+                check_runtime()
+                if remaining_tokens <= 0:
+                    raise OwnershipBudgetExceeded
+                remaining_tokens -= 1
+
+            def bounded_push(*args):
+                consume_token()
+                return original_push(*args)
+
+            def bounded_pending(*args):
+                consume_token()
+                return original_pending(*args)
+
+            state.push = bounded_push
+            if original_pending is not None:
+                state.pushPending = bounded_pending
+            state._ownership_budgeted = True
+
+        original_tokenize = parser.block.tokenize
+
+        def bounded_tokenize(state, start_line, end_line):
+            check_runtime()
+            # The canonical block parser silently discards the remaining source
+            # at its nesting limit, including document-wide link definitions.
+            # Such a partial parse cannot establish any delimiter ownership.
+            if state.level >= state.md.options.maxNesting:
+                raise OwnershipBudgetExceeded
+            install_allocation_budget(state)
+            return original_tokenize(state, start_line, end_line)
+
+        parser.block.tokenize = bounded_tokenize
+        original_inline_tokenize = parser.inline.tokenize
+        original_skip_token = parser.inline.skipToken
+
+        def bounded_inline_tokenize(state):
+            check_runtime()
+            if state.level >= state.md.options.maxNesting:
+                raise OwnershipBudgetExceeded
+            install_allocation_budget(state)
+            return original_inline_tokenize(state)
+
+        def bounded_skip_token(state):
+            check_runtime()
+            if state.level >= state.md.options.maxNesting:
+                raise OwnershipBudgetExceeded
+            return original_skip_token(state)
+
+        # Inline lookahead also skips source silently at the same depth limit.
+        parser.inline.tokenize = bounded_inline_tokenize
+        parser.inline.skipToken = bounded_skip_token
+        try:
+            blocks = parser.parse(content)
+        except OwnershipBudgetExceeded:
+            # Optional delimiter proof is all-or-nothing for allocation and
+            # nesting cutoffs alike. Never trust a partially parsed document.
+            return
+        check_runtime()
+        # CommonMark line maps count only normalized LF, not Unicode line
+        # separators that str.splitlines() would also treat as boundaries.
+        starts = [0, *(i + 1 for i, char in enumerate(content) if char == "\n"), len(content)]
+        table_depth = 0
+        for block in blocks:
+            check_runtime()
+            if block.type == "table_open":
+                table_depth += 1
+            elif block.type == "table_close":
+                table_depth -= 1
+            # Table cells unescape pipes and share a whole-row map. A substring
+            # elsewhere in that row is not proof of this cell's raw origin.
+            if table_depth or block.type == "table_close":
+                continue
+            if block.type != "inline" or not block.map or not block.content:
+                continue
+            start_line, end_line = block.map
+            if end_line >= len(starts):
+                continue
+            start, end = starts[start_line], starts[end_line]
+            origin = content.find(block.content, start, end)
+            if origin < 0 or content.find(block.content, origin + 1, end) >= 0:
+                continue
+            record = records.get(id(block.content))
+            if record is None or record[0] is not block.content:
+                continue
+            # Only events from this complete inline block can own its raw
+            # positions; substring-local image label events remain unassigned.
+            self._closers.update(source_offsets[origin + offset] for offset in record[1])
+
+    def closes_string(self, offset: int) -> bool:
+        return offset in self._closers
