+                    # source even when its implementation is outside the proof.
+                    pending.append(field(function, "object"))
+                if not opaque_only and arguments is not None:
+                    pending.extend(semantic_children(arguments))
+                if (
+                    function is not None
+                    and function.type == "identifier"
+                    and text(function) == "String"
+                ):
+                    if arguments is not None:
+                        pending.extend(semantic_children(arguments))
+                    continue
+                if function is not None and function.type == "member_expression":
+                    member = field(function, "property")
+                    # These operations can construct text from source-authored
+                    # pieces. Arbitrary producer calls with metadata arguments
+                    # are not assumed to return those arguments as source.
+                    if member is not None and text(member) in {
+                        "join",
+                        "concat",
+                        "replace",
+                        "replaceAll",
+                        "slice",
+                        "substring",
+                        "substr",
+                        "trim",
+                        "trimStart",
+                        "trimEnd",
+                        "padStart",
+                        "padEnd",
+                        "repeat",
+                        "normalize",
+                        "toUpperCase",
+                        "toLowerCase",
