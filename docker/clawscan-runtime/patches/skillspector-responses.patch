+    def closes_string(self, offset: int) -> bool:
+        return offset in self._closers
+
+    def delimiter_offsets(self) -> frozenset[int]:
+        """Return proven inline delimiters, preserving every byte inside them."""
+        return frozenset(self._delimiters)
