--- /dev/null
+++ b/src/skillspector/markdown_tokens.py
@@ -0,0 +1,424 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Conservative raw-source ownership for CommonMark inline syntax and prose."""
+
+import re
+from array import array
+from collections.abc import Callable
+
+from markdown_it import MarkdownIt
+from markdown_it.rules_inline.backticks import backtick
+from markdown_it.rules_inline.text import text as inline_text
+from markdown_it.token import Token
+
+_WORD_APOSTROPHE_RE = re.compile(
+    r"(?<![\w'/.~-])[A-Za-z][A-Za-z0-9_]*+(?P<apostrophe>')(?:s|t|d|m|re|ve|ll)(?![\w'/])",
+    re.IGNORECASE,
+)
+_PLURAL_APOSTROPHE_RE = re.compile(
+    r"(?<![\w'/.~-])[A-Za-z][A-Za-z0-9_]*s(?P<apostrophe>')(?=[ \t]+[A-Za-z])",
+    re.IGNORECASE,
+)
+_PROSE_SHELL_SYNTAX_RE = re.compile(r"[$`\\\"]")
+_CODE_EXPANSION_RE = re.compile(r"[$`\\]")
+_CODE_WORD_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_.-]*")
+_CODE_POSSESSIVE_RE = re.compile(r"'s(?![\w'/])", re.IGNORECASE)
+_CONTAINER_PREFIX_RE = re.compile(
+    r"(?:[ \t]*+(?:>[ \t]?|[-+*][ \t]++|[0-9]{1,9}[.)][ \t]++))*+[ \t]*+"
+)
+
+
+def _inline_source_offsets(content, block, starts, check_runtime):
+    """Map canonical paragraph lines only when every source character agrees."""
+    start_line, end_line = block.map
+    parts = block.content.split("\n")
+    if len(parts) != end_line - start_line:
+        return None
+    offsets = array("I")
+    for index, part in enumerate(parts):
+        check_runtime()
+        start, end = starts[start_line + index], starts[start_line + index + 1]
+        line = content[start:end].removesuffix("\n")
+        origin = line.find(part)
+        if (
+            not part
+            or origin < 0
+            or line.find(part, origin + 1) >= 0
+            or _CONTAINER_PREFIX_RE.fullmatch(line[:origin]) is None
+            or line[origin + len(part) :].strip(" \t")
+        ):
+            return None
+        offsets.extend(range(start + origin, start + origin + len(part)))
+        if index + 1 < len(parts):
+            offsets.append(end - 1)
+    return offsets
+
+
+def _prose_apostrophes(source, text_positions, code_record, code_ranges, check_runtime):
+    """Prove punctuation in canonical text after composing inline delimiters."""
+    projected = list(source)
+    suffix_bases = set()
+    if code_record is not None:
+        for start, end in code_ranges:
+            check_runtime()
+            opening_end = start
+            while opening_end < end and source[opening_end] == "`":
+                check_runtime()
+                opening_end += 1
+            width = opening_end - start
+            # Code content stays raw in finding production and the caller's
+            # shell-word precedence pass. Expansions and escapes cannot lend
+            # their context to punctuation in a neighboring text node.
+            if _CODE_EXPANSION_RE.search(source, opening_end, end - width):
+                return set()
+            projected[start:end] = " " * (end - start)
+        suffix_bases = code_record[3]
+    projected = "".join(projected)
+    if _PROSE_SHELL_SYNTAX_RE.search(projected):
+        return set()
+    candidates = {match.start("apostrophe") for match in _WORD_APOSTROPHE_RE.finditer(projected)}
+    candidates.update(
+        match.start("apostrophe") for match in _PLURAL_APOSTROPHE_RE.finditer(projected)
+    )
+    candidates.update(
+        match.start()
+        for match in _CODE_POSSESSIVE_RE.finditer(projected)
+        if match.start() in suffix_bases
+    )
+    candidates.intersection_update(text_positions)
+    # Every remaining text quote must be prose punctuation. Code content stays
+    # available to the caller's shell parser before any punctuation is masked.
+    return candidates if len(candidates) == projected.count("'") else set()
+
+
+def _table_inline_origins(
+    content: str,
+    blocks: list[Token],
+    starts: list[int],
+    check_runtime: Callable[[], None],
+) -> dict[int, int]:
+    """Map only complete, verbatim canonical rows to their exact source cells."""
+    origins: dict[int, int] = {}
+    table_depth = 0
+    row_map: list[int] | None = None
+    row_blocks: list[Token] = []
+    for block in blocks:
+        check_runtime()
+        if block.type == "table_open":
+            table_depth += 1
+        elif block.type == "table_close":
+            table_depth -= 1
+        elif table_depth and block.type == "tr_open":
+            row_map, row_blocks = block.map, []
+        elif table_depth and block.type == "inline":
+            row_blocks.append(block)
+        elif table_depth and block.type == "tr_close":
+            if not row_map or row_map[1] != row_map[0] + 1 or row_map[1] >= len(starts):
+                continue
+            start, end = starts[row_map[0]], starts[row_map[1]]
+            line = content[start:end].removesuffix("\n")
+            # The canonical table extension unescapes pipes in cell source.
+            # Such rows require a richer source map; preserve the fallback.
+            if "\\|" in line:
+                continue
+            cells: list[tuple[str, int]] = []
+            cursor = 0
+            for raw in line.split("|"):
+                check_runtime()
+                cells.append((raw.strip(), start + cursor + len(raw) - len(raw.lstrip())))
+                cursor += len(raw) + 1
+            if cells and not cells[0][0]:
+                cells.pop(0)
+            if cells and not cells[-1][0]:
+                cells.pop()
+            # No virtual padding, discarded extra cells or container prefixes
+            # can establish ownership. Every cell must map in source order.
+            if len(cells) != len(row_blocks) or any(
+                text != inline.content for (text, _), inline in zip(cells, row_blocks, strict=True)
+            ):
+                continue
+            origins.update(
+                (id(inline), origin) for (_, origin), inline in zip(cells, row_blocks, strict=True)
+            )
+    return origins
+
+
+class MarkdownCodeSpanClosers:
+    """Prove closing backticks without hiding the contents of a code span.
+
+    A block's inline source must map uniquely and verbatim to the original
+    text. Containers that remove prefixes from continuation lines, escaped
+    delimiters, uncertain mappings and oversized documents grant no ownership.
+    Optional table ownership maps every canonical cell verbatim and in source order.
+    Fenced/indented code and raw HTML never grant inline ownership.
+    Optional prose ownership composes canonical text and code nodes without
+    removing code content. Its positions still require shell-word precedence.
+    """
+
+    def __init__(
+        self,
+        content: str,
+        check_runtime: Callable[[], None],
+        *,
+        excluded_ranges: tuple[tuple[int, int], ...] = (),
+        include_tables: bool = False,
+        collect_prose: bool = False,
+        collect_code: bool = False,
+    ):
+        self._closers: set[int] = set()
+        self._delimiters: set[int] = set()
+        self._prose_apostrophes: set[int] = set()
+        self._inline_code_bodies: list[tuple[int, int]] = []
+        check_runtime()
+        # This optional proof only refines the existing lexical fallback. If
+        # unavailable, preserve that fallback rather than asserting coverage.
+        if len(content) > 1_048_576:
+            return
+        # CommonMark normalizes physical newlines before inline parsing. Keep
+        # an exact map back to raw characters; the artifact is never rewritten.
+        source_offsets = array("I")
+        normalized = []
+        cursor = 0
+        while cursor < len(content):
+            if cursor % 4096 == 0:
+                check_runtime()
+            char = content[cursor]
+            source_offsets.append(cursor)
+            normalized.append("\n" if char == "\r" else char)
+            cursor += 2 if content.startswith("\r\n", cursor) else 1
+        source_offsets.append(len(content))
+        content = "".join(normalized)
+        parser = MarkdownIt("commonmark").enable("table")
+        # Observe the original document parse, including its reference-link
+        # environment. Each nested image state has a distinct source object;
+        # keep strong source references so identities cannot be reused.
+        records: dict[int, tuple[str, set[int], set[int], set[int]]] = {}
+        code_ranges: dict[int, list[tuple[int, int]]] = {}
+        text_records: dict[int, tuple[str, set[int]]] = {}
+
+        def record_backtick(state, silent):
+            check_runtime()
+            before = len(state.tokens)
+            opening_start = state.pos
+            matched = backtick(state, silent)
+            if matched and not silent and len(state.tokens) > before:
+                token = state.tokens[-1]
+                if token.type == "code_inline":
+                    _, closers, openers, suffixes = records.setdefault(
+                        id(state.src), (state.src, set(), set(), set())
+                    )
+                    openers.update(range(opening_start, opening_start + len(token.markup)))
+                    closers.update(
+                        i
+                        for i in range(state.pos - len(token.markup), state.pos)
+                        if state.src[i] == "`"
+                    )
+                    if collect_prose or collect_code:
+                        code_ranges.setdefault(id(state.src), []).append((opening_start, state.pos))
+                    if collect_prose:
+                        if _CODE_WORD_RE.fullmatch(token.content):
+                            suffixes.add(state.pos)
+            return matched
+
+        parser.inline.ruler.at("backticks", record_backtick)
+
+        if collect_prose:
+
+            def record_text(state, silent):
+                check_runtime()
+                start = state.pos
+                matched = inline_text(state, silent)
+                if matched and not silent:
+                    _, positions = text_records.setdefault(id(state.src), (state.src, set()))
+                    for offset in range(start, state.pos):
+                        if (offset - start) % 4096 == 0:
+                            check_runtime()
+                        if state.src[offset] == "'":
+                            positions.add(offset)
+                return matched
+
+            parser.inline.ruler.at("text", record_text)
+
+        # GFM tables can synthesize many empty cells from very little source.
+        # Enforce one shared document-wide budget BEFORE block or inline token
+        # allocation, including nested states and pending-text tokens. Inline
+        # emphasis/delimiter expansion can amplify source just as tables do.
+        class OwnershipBudgetExceededError(Exception):
+            pass
+
+        remaining_tokens = 8192
+
+        def install_allocation_budget(state):
+            if getattr(state, "_ownership_budgeted", False):
+                return
+            original_push = state.push
+            original_pending = getattr(state, "pushPending", None)
+
+            def consume_token():
+                nonlocal remaining_tokens
+                check_runtime()
+                if remaining_tokens <= 0:
+                    raise OwnershipBudgetExceededError
+                remaining_tokens -= 1
+
+            def bounded_push(*args):
+                consume_token()
+                return original_push(*args)
+
+            def bounded_pending(*args):
+                consume_token()
+                return original_pending(*args)
+
+            state.push = bounded_push
+            if original_pending is not None:
+                state.pushPending = bounded_pending
+            state._ownership_budgeted = True
+
+        original_tokenize = parser.block.tokenize
+
+        def bounded_tokenize(state, start_line, end_line):
+            check_runtime()
+            # The canonical block parser silently discards the remaining source
+            # at its nesting limit, including document-wide link definitions.
+            # Such a partial parse cannot establish any delimiter ownership.
+            if state.level >= state.md.options.maxNesting:
+                raise OwnershipBudgetExceededError
+            install_allocation_budget(state)
+            return original_tokenize(state, start_line, end_line)
+
+        parser.block.tokenize = bounded_tokenize
+        original_inline_tokenize = parser.inline.tokenize
+        original_skip_token = parser.inline.skipToken
+
+        def bounded_inline_tokenize(state):
+            check_runtime()
+            if state.level >= state.md.options.maxNesting:
+                raise OwnershipBudgetExceededError
+            install_allocation_budget(state)
+            return original_inline_tokenize(state)
+
+        def bounded_skip_token(state):
+            check_runtime()
+            if state.level >= state.md.options.maxNesting:
+                raise OwnershipBudgetExceededError
+            return original_skip_token(state)
+
+        # Inline lookahead also skips source silently at the same depth limit.
+        parser.inline.tokenize = bounded_inline_tokenize
+        parser.inline.skipToken = bounded_skip_token
+        try:
+            blocks = parser.parse(content)
+        except OwnershipBudgetExceededError:
+            # Optional delimiter proof is all-or-nothing for allocation and
+            # nesting cutoffs alike. Never trust a partially parsed document.
+            return
+        check_runtime()
+        # CommonMark line maps count only normalized LF, not Unicode line
+        # separators that str.splitlines() would also treat as boundaries.
+        starts = [0, *(i + 1 for i, char in enumerate(content) if char == "\n"), len(content)]
+        table_origins = (
+            _table_inline_origins(content, blocks, starts, check_runtime) if include_tables else {}
+        )
+        table_depth = 0
+        quote_depth = 0
+        for block_index, block in enumerate(blocks):
+            check_runtime()
+            if block.type == "blockquote_open":
+                quote_depth += 1
+            elif block.type == "blockquote_close":
+                quote_depth -= 1
+            if block.type == "table_open":
+                table_depth += 1
+            elif block.type == "table_close":
+                table_depth -= 1
+            if block.type == "table_close":
+                continue
+            if block.type != "inline" or not block.map or not block.content:
+                continue
+            start_line, end_line = block.map
+            if end_line >= len(starts):
+                continue
+            start, end = starts[start_line], starts[end_line]
+            # Preserve the existing shell projection's stricter table
+            # boundaries when the optional canonical parser disagrees.
+            if any(
+                source_offsets[start] < excluded_end and excluded_start < source_offsets[end]
+                for excluded_start, excluded_end in excluded_ranges
+            ):
+                continue
+            if table_depth:
+                origin = table_origins.get(id(block))
+                if origin is None:
+                    continue
+            else:
+                origin = content.find(block.content, start, end)
+                if origin < 0 or content.find(block.content, origin + 1, end) >= 0:
+                    origin = None
+            record = records.get(id(block.content))
+            if record is not None and record[0] is not block.content:
+                record = None
+            text_record = text_records.get(id(block.content))
+            if (
+                collect_prose
+                and not quote_depth
+                and text_record is not None
+                and text_record[0] is block.content
+                and (
+                    table_depth
+                    or block_index
+                    and blocks[block_index - 1].type in {"paragraph_open", "heading_open"}
+                )
+                and not any(child.type == "html_inline" for child in block.children or ())
+            ):
+                mapping = (
+                    range(origin, origin + len(block.content))
+                    if origin is not None
+                    else _inline_source_offsets(content, block, starts, check_runtime)
+                )
+                if mapping is not None:
+                    for offset in _prose_apostrophes(
+                        block.content,
+                        text_record[1],
+                        record,
+                        code_ranges.get(id(block.content), ()),
+                        check_runtime,
+                    ):
+                        check_runtime()
+                        normalized_offset = mapping[offset]
+                        if content[normalized_offset] == block.content[offset] == "'":
+                            self._prose_apostrophes.add(source_offsets[normalized_offset])
+            if record is None or origin is None:
+                continue
+            if collect_code:
+                for code_start, code_end in code_ranges.get(id(block.content), ()):
+                    width = 0
+                    while block.content[code_start + width] == "`":
+                        check_runtime()
+                        width += 1
+                    self._inline_code_bodies.append(
+                        (
+                            source_offsets[origin + code_start + width],
+                            source_offsets[origin + code_end - width],
+                        )
+                    )
+            # Only events from this complete inline block can own its raw
+            # positions; substring-local image label events remain unassigned.
+            self._closers.update(source_offsets[origin + offset] for offset in record[1])
+            self._delimiters.update(
+                source_offsets[origin + offset] for offset in record[1] | record[2]
+            )
+
+    def closes_string(self, offset: int) -> bool:
+        return offset in self._closers
+
+    def delimiter_offsets(self) -> frozenset[int]:
+        """Return proven inline delimiters, preserving every byte inside them."""
+        return frozenset(self._delimiters)
+
+    def prose_apostrophe_offsets(self) -> frozenset[int]:
+        """Return exact text-node punctuation; callers retain shell-word precedence."""
+        return frozenset(self._prose_apostrophes)
+
+    def inline_code_bodies(self) -> tuple[tuple[int, int], ...]:
+        """Return exact raw bodies of complete canonical inline code spans."""
+        return tuple(self._inline_code_bodies)
