+        elif role == "page":
+            dictionary(
+                value,
+                {"/Type", "/Parent", "/MediaBox", "/Resources", "/Contents", "/Rotate", "/Trans"},
+                {"/Type", "/Parent", "/MediaBox", "/Resources", "/Contents"},
+            )
+            name(value.Type, {"/Page"})
+            if active.get(value.Parent.objgen) != "pages":
+                raise UnsupportedPdfError
+            array(value.MediaBox, 4)
+            for coordinate in value.MediaBox:
+                number(coordinate)
+            if list(value.MediaBox[:2]) != [0, 0] or not all(
+                0 < edge <= 14400 for edge in value.MediaBox[2:]
+            ):
+                raise UnsupportedPdfError
+            layout = TextLayout(float(value.MediaBox[2]), float(value.MediaBox[3]))
+            if "/Rotate" in value:
+                if type(value.Rotate) is not int or value.Rotate != 0:
+                    raise UnsupportedPdfError
+            if "/Trans" in value:
+                dictionary(value.Trans, set())
+            visit(value.Resources, "resources", depth + 1)
+            font_names = set(value.Resources.Font.keys())
+            contents = value.Contents
+            if isinstance(contents, pikepdf.Array):
+                array(contents)
+                for stream in contents:
