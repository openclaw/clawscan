+    def _callback_parameter(self, function, definition):
+        arguments = self.parent(function)
+        call = self.parent(arguments) if arguments is not None else None
+        method = self.field(call, "function")
+        if (
+            arguments is None
+            or arguments.type != "arguments"
+            or self.children(arguments)[:1] != [function]
+        ):
+            return None
+        if method is None or method.type != "member_expression":
+            return None
+        name = self.field(method, "property")
+        if name is None or self.text(name) not in {"map", "filter"}:
+            return None
+        parameters = self.children(self.field(function, "parameters"))
+        parameter = self.field(function, "parameter")
+        if parameter is not None:
+            parameters.append(parameter)
+        body = self.field(function, "body")
+        if (
+            parameters != [definition]
+            or definition.type != "identifier"
+            or body is None
+            or body.type == "statement_block"
+        ):
+            return None
+        if any(c.type == "async" for c in function.children):
+            return None
+        receiver = self.kind(self.field(method, "object"))
+        return receiver[1] if receiver is not None and receiver[0] == "array" else None
+
+    def _method_kind(self, function, args):
+        receiver = self.kind(self.field(function, "object"))
+        member = self.field(function, "property")
+        if receiver is None or member is None:
+            return None
+        name = self.text(member)
+        if receiver[0] == "regexp" and name in {"test", "exec"} and len(args) == 1:
+            if self.kind(args[0]) == ("string",):
+                return ("boolean",) if name == "test" else ("match",)
+        if receiver == ("number",) and name == "toFixed" and len(args) <= 1:
+            if all(self.kind(a) == ("number",) for a in args):
+                return ("string",)
+        if receiver == ("string",):
+            if (
+                name in {"match", "matchAll"}
+                and len(args) == 1
+                and self.kind(args[0]) == ("regexp",)
+            ):
+                return ("match",) if name == "match" else ("iterator", ("match",))
+            if name in {"trim", "toLowerCase"} and not args:
+                return ("string",)
+            if name == "slice" and all(self.kind(a) == ("number",) for a in args):
+                return ("string",)
+            if (
+                name == "split"
+                and len(args) == 1
+                and self.kind(args[0]) in (("regexp",), ("string",))
+            ):
+                return ("array", ("string",))
+            if (
+                name in {"includes", "startsWith"}
+                and len(args) == 1
+                and self.kind(args[0]) == ("string",)
+            ):
+                return ("boolean",)
+        if receiver[0] == "array":
+            if name == "join" and len(args) <= 1 and self.primitive(receiver[1]):
+                if all(self.kind(a) == ("string",) for a in args):
