+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Bounded syntax ownership after a closed JavaScript value/use proof.
+
+Unresolved constructed values grant no ownership. Proven data literal syntax
+and comments cannot consume later host code as shell operands. Findings always
+inspect the original source, including every interpolation expression.
+"""
+
+from __future__ import annotations
+
+import re
+from bisect import bisect_right
+from collections.abc import Callable
+
+from skillspector.javascript_values import OwnershipBudgetExceededError, data_literal_ranges
+
+MAX_SOURCE_BYTES = 262_144
+MAX_NODES = 100_000
+MAX_DEPTH = 256
+PARSE_TIMEOUT_MICROS = 100_000
+_JAVASCRIPT_SHEBANG = re.compile(
+    r"#![ \t]*+(?:\S*/)?(?:env[ \t]++(?:-\S*[ \t]++)*(?:\S*/)?)?"
+    r"(?:node|nodejs|bun|deno)(?=[ \t\r\n]|$)"
+)
+
+
+class JavaScriptSourceOwnership:
+    def __init__(self, content: str, check_runtime: Callable[[], None]):
+        self._content = content
+        self._check_runtime = check_runtime
+        self._spans: tuple[tuple[int, ...], tuple[int, ...]] | None = None
+        self._literals: tuple[tuple[int, ...], tuple[int, ...]] | None = None
+        self._noncode: tuple[tuple[int, ...], tuple[int, ...]] | None = None
+        self._computed = False
+
+    def _compute(self):
+        if not self._computed:
+            result = _source_spans(self._content, self._check_runtime)
+            if result is not None:
+                self._spans, self._literals, self._noncode = result
+            self._computed = True
+
+    def _owner(self, spans, position):
+        if spans is None:
+            return None
+        starts, ends = spans
+        index = bisect_right(starts, position) - 1
+        if index >= 0 and position < ends[index]:
+            return starts[index], ends[index]
+        return None
+
+    def comment(self, position: int) -> tuple[int, int] | None:
+        self._compute()
+        return self._owner(self._spans, position)
+
+    def data_literal(self, position: int) -> tuple[int, int] | None:
+        self._compute()
+        return self._owner(self._literals, position)
+
+    def is_code(self, position: int) -> bool:
+        self._compute()
+        return self._noncode is not None and self._owner(self._noncode, position) is None
+
+
+def _source_spans(
+    content: str, check_runtime: Callable[[], None]
+) -> tuple[tuple[int, ...], tuple[int, ...]] | None:
+    if len(content) > MAX_SOURCE_BYTES or (
+        content.startswith("#!") and _JAVASCRIPT_SHEBANG.match(content) is None
+    ):
+        return None
+    check_runtime()
+    try:
+        data = content.encode("utf-8")
+    except UnicodeError:
+        return None
+    if len(data) > MAX_SOURCE_BYTES:
+        return None
+    try:
+        import tree_sitter_javascript
+        from tree_sitter import Language, Parser
+    except ImportError:
+        return None
+    # The pinned binding supports this deprecated native deadline. Leave the
+    # caller's warning filters untouched; concurrent analyzers own their parser.
+    # Strict warning-as-error settings conservatively prove no ownership.
+    try:
+        parser = Parser(
+            Language(tree_sitter_javascript.language()), timeout_micros=PARSE_TIMEOUT_MICROS
+        )
+        tree = parser.parse(data)
+    except (ValueError, RuntimeError, DeprecationWarning):
+        return None
+    check_runtime()
+    if tree is None or tree.root_node.has_error:
+        return None
+    pending = [(tree.root_node, 0, None)]
+    comments: list[tuple[int, int]] = []
+    nodes, parents = [], {}
+    count = 0
+    while pending:
+        node, depth, owner = pending.pop()
+        nodes.append(node)
+        parents[node.id] = owner
+        count += 1
+        if count > MAX_NODES or depth > MAX_DEPTH:
+            return None
+        if count % 128 == 0:
+            check_runtime()
+        if node.type == "comment":
+            start, end = node.start_byte, node.end_byte
+            raw = data[start:end]
+            if not (raw.startswith(b"//") or (raw.startswith(b"/*") and raw.endswith(b"*/"))):
+                return None
+            comments.append((start, end))
+        pending.extend((child, depth + 1, node) for child in node.children)
+    try:
+        literals = data_literal_ranges(data, nodes, parents, check_runtime)
+    except OwnershipBudgetExceededError:
+        return None
+    if literals is None:
+        return None
+    noncode = list(comments)
+    for node in nodes:
+        if node.type in {"string", "regex"}:
+            noncode.append((node.start_byte, node.end_byte))
+        if node.type == "template_string":
+            cursor = node.start_byte
+            for child in node.children:
+                if child.type == "template_substitution":
+                    expression = child.named_children[0]
+                    noncode.append((cursor, expression.start_byte))
+                    cursor = expression.end_byte
+            noncode.append((cursor, node.end_byte))
+    # Tree-sitter offsets count UTF-8 bytes. Decode disjoint ranges only once
+    # to preserve exact character offsets without repeated prefix decoding.
+    result = []
+    for ranges in (comments, literals, noncode):
+        starts, ends = [], []
+        byte_cursor = char_cursor = 0
+        for start, end in sorted(ranges):
+            check_runtime()
+            if start < byte_cursor:
+                return None
+            char_cursor += len(data[byte_cursor:start].decode("utf-8"))
+            starts.append(char_cursor)
+            char_cursor += len(data[start:end].decode("utf-8"))
+            ends.append(char_cursor)
+            byte_cursor = end
+        result.append((tuple(starts), tuple(ends)))
+    return tuple(result)
