+
+    def authored_string_constructor(initial):
+        # This is positive source attribution only, never a native identity
+        # proof: replacing a constructor cannot erase its authored input path.
+        pending, seen = [initial], set()
+        while pending:
+            step()
+            node = pending.pop()
+            if node is None or node.id in seen:
+                continue
+            seen.add(node.id)
+            if node.type == "member_expression":
+                member = field(node, "property")
+                if member is not None and text(member) in {"fromCharCode", "fromCodePoint"}:
+                    return True
+            if node.type == "identifier":
+                definition = data_definition(node)
+                if definition is not None:
+                    owner = parent(definition)
+                    if (
+                        owner is not None
+                        and owner.type == "variable_declarator"
+                        and const_declaration(owner)
+                    ):
+                        pending.append(field(owner, "value"))
+        return False
+
+    def authored_value(initial):
+        """Trace source-authored pieces; native file/network contents are external."""
+        pending, visited = [initial], set()
+        while pending:
+            step()
+            node = pending.pop()
+            if node is None or node.id in visited:
+                continue
+            visited.add(node.id)
+            if node.type == "template_string":
+                return True
+            if node.type == "string":
+                if text(node)[1:-1]:
+                    return True
+                continue
+            if node.type == "identifier":
+                defs = definitions[text(node)]
+                if len(defs) == 1:
+                    owner = parent(defs[0])
+                    if owner is not None and owner.type == "variable_declarator":
+                        pending.append(field(owner, "value"))
+                continue
