+        import tree_sitter_javascript
+        from tree_sitter import Language, Parser
+    except ImportError:
+        return None
+    # The pinned binding supports this deprecated native deadline. Leave the
+    # caller's warning filters untouched; concurrent analyzers own their parser.
+    # Strict warning-as-error settings conservatively prove no ownership.
+    try:
+        parser = Parser(
+            Language(tree_sitter_javascript.language()), timeout_micros=PARSE_TIMEOUT_MICROS
+        )
