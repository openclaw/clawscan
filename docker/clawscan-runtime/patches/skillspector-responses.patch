         model, include_seed=True, reasoning_effort=reasoning_effort
     )
     kwargs.update(sampling_parameters)
+    # Sol exposes tool calls only on Responses, not Chat Completions. Keep
+    # other models and OpenAI-compatible providers on their existing route.
+    if model == "gpt-6.1-sol":
+        if "seed" in sampling_parameters:
+            raise UnsupportedControlError(
+                "SKILLSPECTOR_SEED is not supported by the Sol Responses API; unset it"
+            )
+        kwargs["use_responses_api"] = True
+        service_tier = (os.getenv("SKILLSPECTOR_SERVICE_TIER") or "default").strip() or "default"
+        if service_tier not in {"auto", "default", "flex", "priority"}:
+            raise UnsupportedControlError("Unsupported SKILLSPECTOR_SERVICE_TIER")
+        kwargs["service_tier"] = service_tier
     chat_model = ChatOpenAI(**kwargs)
     register_chat_model_controls(
         chat_model,
