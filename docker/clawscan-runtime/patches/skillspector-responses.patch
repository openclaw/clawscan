+    def _storage_definition(self, function):
+        receiver = self.field(function, "object")
+        member = self.field(function, "property")
+        if (
+            receiver is None
+            or receiver.type != "identifier"
+            or member is None
+            or self.text(member) != "push"
+        ):
+            return None
+        definition = self.definition(receiver)
+        value = self.const_value(definition) if definition is not None else None
+        return (
+            definition
+            if value is not None and value.type == "array" and not self.children(value)
+            else None
+        )
