+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""A deliberately small, closed value/use proof for JavaScript data strings.
+
+Native filesystem paths, fetch URLs, stream writes, and directly thrown Error
+messages do not interpret strings as shell source. A spelling alone proves
+nothing: imports, immutable aliases, every local value use, and ambient-name
+shadowing are checked against the complete parsed module. Unsupported value
+flows grant no ownership for the artifact.
+"""
+
+from collections import defaultdict
+
+_GLOBAL_CAPABILITIES = {"Error", "fetch", "process", "JSON"}
+_FORBIDDEN_GLOBALS = {
+    "globalThis",
+    "global",
+    "window",
+    "self",
+    "Reflect",
+    "eval",
+    "Function",
+    "require",
+}
+_NATIVE_MODULES = {
+    "node:fs",
+    "node:fs/promises",
+    "node:path",
+    "node:crypto",
+    "node:stream",
+    "node:stream/promises",
+}
+_FS_PATH_ARGUMENTS = {
+    "createWriteStream": {0},
+    "readFile": {0},
+    "open": {0},
+    "rename": {0, 1},
+    "rm": {0},
+    "mkdir": {0},
+    "stat": {0},
+}
+MAX_PROOF_STEPS = 100_000
+
+
+class OwnershipBudgetExceededError(Exception):
+    pass
+
+
+def data_literal_ranges(data, nodes, parents, check_runtime):
+    """Return exact syntax/data ranges, or None when any constructed value escapes."""
+    definitions = defaultdict(list)
+    references = defaultdict(list)
+    imported = {}
+    remaining = MAX_PROOF_STEPS
+
+    def step():
+        nonlocal remaining
+        remaining -= 1
+        if remaining < 0:
+            raise OwnershipBudgetExceededError
+        check_runtime()
+
+    def text(node):
+        return data[node.start_byte : node.end_byte].decode("utf-8")
+
+    def parent(node):
+        return parents.get(node.id)
+
+    def field(node, name):
+        return node.child_by_field_name(name)
+
+    def const_declaration(node):
+        p = parent(node)
+        return (
+            p is not None
+            and p.type == "lexical_declaration"
+            and data[p.start_byte : p.start_byte + 5] == b"const"
+        )
+
+    for node in nodes:
+        step()
+        if node.type == "with_statement":
+            return None
+        if node.type in {"identifier", "shorthand_property_identifier"}:
+            references[text(node)].append(node)
+        if node.type in {"variable_declarator", "function_declaration", "class_declaration"}:
+            name = field(node, "name")
+            if name is not None and name.type == "identifier":
+                definitions[text(name)].append(name)
+        if node.type in {"formal_parameters", "catch_clause"}:
+            target = field(node, "parameter") if node.type == "catch_clause" else node
+            if target is not None:
+                stack = [target]
+                while stack:
+                    child = stack.pop()
+                    if child.type == "identifier":
+                        definitions[text(child)].append(child)
+                    stack.extend(child.named_children)
+        if node.type == "arrow_function":
+            name = field(node, "parameter")
+            if name is not None and name.type == "identifier":
+                definitions[text(name)].append(name)
+        if node.type == "import_statement":
+            source = field(node, "source")
+            module = text(source)[1:-1] if source is not None else ""
+            if module not in _NATIVE_MODULES or "\\" in module:
+                return None
+            stack = list(node.named_children)
+            while stack:
+                child = stack.pop()
+                if child.type == "import_specifier":
+                    original = field(child, "name")
+                    local = field(child, "alias") or original
+                    if original is None or local is None:
+                        return None
+                    definitions[text(local)].append(local)
+                    imported[text(local)] = (module, text(original))
+                elif child.type in {"namespace_import", "import_clause"}:
+                    # Default and namespace objects are mutable or ambiguous in
+                    # this first slice. Named ESM imports have stable identity.
+                    if any(c.type == "identifier" for c in child.named_children):
+                        return None
+                    stack.extend(child.named_children)
+                elif child.type != "string":
+                    stack.extend(child.named_children)
+
+    def capability(node, visiting=frozenset()):
+        step()
+        if node is None or node.id in visiting or len(visiting) > 128:
+            return None
+        visiting = visiting | {node.id}
+        if node.type in {"identifier", "shorthand_property_identifier"}:
+            name = text(node)
+            defs = definitions[name]
+            if name in _GLOBAL_CAPABILITIES and not defs:
+                return ("ambient", name)
+            if len(defs) != 1:
+                return None
+            if name in imported:
+                return imported[name]
+            owner = parent(defs[0])
+            if (
+                owner is not None
+                and owner.type == "variable_declarator"
+                and const_declaration(owner)
+            ):
+                return capability(field(owner, "value"), visiting)
+            return None
+        if node.type == "member_expression":
+            base = capability(field(node, "object"), visiting)
+            member = field(node, "property")
+            if base is not None and member is not None and member.type == "property_identifier":
+                result = (base[0], base[1] + "." + text(member))
+                if (
+                    base[0] == "ambient"
+                    and base[1].startswith("process")
+                    and result[1]
+                    not in {
+                        "process.stdout",
+                        "process.stderr",
+                        "process.stdout.write",
+                        "process.stderr.write",
+                        "process.exitCode",
+                    }
+                ):
+                    return None
+                return result
+        if node.type == "parenthesized_expression" and len(node.named_children) == 1:
+            return capability(node.named_children[0], visiting)
+        return None
+
+    def target_mutates_capability(initial):
+        pending = [initial]
+        while pending:
+            step()
+            node = pending.pop()
+            if node is None:
+                continue
+            cap = capability(node)
+            if cap not in {None, ("ambient", "process.exitCode")}:
+                return True
+            if (
+                node.type == "subscript_expression"
+                and capability(field(node, "object")) is not None
+            ):
+                return True
+            if node.type in {
+                "object_pattern",
+                "array_pattern",
+                "pair_pattern",
+                "parenthesized_expression",
+            }:
+                pending.extend(node.named_children)
+            if (
+                node.type == "identifier"
+                and text(node) in {"String", "Number", "Boolean", "setTimeout", "clearTimeout"}
+                and not definitions[text(node)]
+            ):
+                return True
+        return False
+
+    # Ambient constructors can be shadowed or replaced; reflective global
+    # access and escaping aliases cannot establish the required native binding.
+    for node in nodes:
+        step()
+        if node.type == "identifier" and text(node) in _FORBIDDEN_GLOBALS:
+            return None
+        if node.type == "member_expression":
+            member = field(node, "property")
+            if member is not None and text(member) in {"constructor", "call", "apply", "bind"}:
+                return None
+        cap = capability(node)
+        if cap is not None:
+            p = parent(node)
+            if p is None:
+                return None
+            native_binding = p.type == "import_specifier"
+            const_alias = p.type == "variable_declarator" and const_declaration(p)
+            member_receiver = p.type == "member_expression" and field(p, "object") == node
+            invoked = p.type in {"call_expression", "new_expression"} and (
+                field(p, "function") == node or field(p, "constructor") == node
+            )
+            exit_status = (
+                cap == ("ambient", "process.exitCode")
+                and p.type == "assignment_expression"
+                and field(p, "left") == node
+            )
+            if not (native_binding or const_alias or member_receiver or invoked or exit_status):
+                return None
+        if node.type in {
+            "assignment_expression",
+            "augmented_assignment_expression",
+            "update_expression",
+        }:
+            target = field(node, "left") or field(node, "argument")
+            if target_mutates_capability(target):
+                return None
+        if node.type == "call_expression":
+            function = field(node, "function")
+            if function is None:
+                return None
+            if function.type in {"subscript_expression", "import"}:
+                return None
+            if function.type == "identifier":
+                name = text(function)
+                defs = definitions[name]
+                local_function = len(defs) == 1 and parent(defs[0]).type == "function_declaration"
+                native = capability(function)
+                # Unbound execution APIs and aliases are never assumed data
+                # sinks. Supported host primitives below take no source code.
+                ambient = not defs and name in {"String", "Number", "Boolean", "clearTimeout"}
+                if not defs and name == "setTimeout":
+                    arguments = field(node, "arguments")
+                    ambient = (
+                        arguments is not None
+                        and bool(arguments.named_children)
+                        and arguments.named_children[0].type
+                        in {"arrow_function", "function_expression"}
+                    )
+                if not local_function and native is None and not ambient:
+                    return None
+            if function.type == "member_expression":
+                member = field(function, "property")
+                if member is not None and text(member) in {
+                    "constructor",
+                    "call",
+                    "apply",
+                    "bind",
+                    "defineProperty",
+                    "setPrototypeOf",
+                }:
+                    return None
+                if member is not None and text(member) == "assign":
+                    args = field(node, "arguments")
+                    if (
+                        args is None
+                        or not args.named_children
+                        or capability(args.named_children[0]) is not None
+                    ):
+                        return None
+
+    def is_data(initial):
+        pending = [initial]
+        visited = set()
+        while pending:
+            step()
+            node = pending.pop()
+            if node.id in visited:
+                continue
+            visited.add(node.id)
+            p = parent(node)
+            if p is None:
+                return False
+            if p.type in {
+                "parenthesized_expression",
+                "binary_expression",
+                "ternary_expression",
+                "sequence_expression",
+                "template_substitution",
+                "template_string",
+            }:
+                pending.append(p)
+                continue
+            if (
+                p.type == "variable_declarator"
+                and field(p, "value") == node
+                and const_declaration(p)
+            ):
+                name = field(p, "name")
+                if name is None or name.type != "identifier" or len(definitions[text(name)]) != 1:
+                    return False
+                declaration = parent(p)
+                if (
+                    parent(declaration) is not None
+                    and parent(declaration).type == "export_statement"
+                ):
+                    return False
+                uses = [n for n in references[text(name)] if n.id != name.id]
+                if not uses:
+                    return False
+                pending.extend(uses)
+                continue
+            if p.type != "arguments":
+                return False
+            call = parent(p)
+            if call is None or call.type not in {"call_expression", "new_expression"}:
+                return False
+            arguments = p.named_children
+            try:
+                index = arguments.index(node)
+            except ValueError:
+                return False
+            cap = capability(
+                field(call, "constructor" if call.type == "new_expression" else "function")
+            )
+            if cap == ("ambient", "Error") and call.type == "new_expression" and index == 0:
+                outer = parent(call)
+                if outer is not None and outer.type == "throw_statement":
+                    continue
+                return False
+            if (
+                cap
+                in {
+                    ("ambient", "fetch"),
+                    ("ambient", "process.stdout.write"),
+                    ("ambient", "process.stderr.write"),
+                }
+                and index == 0
+            ):
+                continue
+            if (
+                cap is not None
+                and cap[0] in {"node:fs", "node:fs/promises"}
+                and index in _FS_PATH_ARGUMENTS.get(cap[1], set())
+            ):
+                continue
+            if (
+                cap is not None
+                and cap[0] == "node:path"
+                and cap[1] in {"join", "resolve", "dirname", "basename"}
+            ):
+                pending.append(call)
+                continue
+            return False
+        return True
+
+    def native_array_method(function):
+        if function.type != "member_expression":
+            return False
+        receiver, member = field(function, "object"), field(function, "property")
+        if (
+            receiver is None
+            or receiver.type != "identifier"
+            or member is None
+            or text(member) != "join"
+        ):
+            return False
+        name = text(receiver)
+        if len(definitions[name]) != 1:
+            return False
+        declaration = parent(definitions[name][0])
+        if (
+            declaration is None
+            or declaration.type != "variable_declarator"
+            or not const_declaration(declaration)
+        ):
+            return False
+        value = field(declaration, "value")
+        if value is None or value.type != "array":
+            return False
+        for reference in references[name]:
+            step()
+            if reference.id == definitions[name][0].id:
+                continue
+            owner = parent(reference)
+            if (
+                owner is None
+                or owner.type != "member_expression"
+                or field(owner, "object") != reference
+            ):
+                return False
+            method, call = field(owner, "property"), parent(owner)
+            if method is None or text(method) not in {"join", "includes", "indexOf", "lastIndexOf"}:
+                return False
+            if call is None or call.type != "call_expression" or field(call, "function") != owner:
+                return False
+        return True
+
+    def field_calls_are_data(initial):
+        pending = [initial]
+        while pending:
+            step()
+            node = pending.pop()
+            if node.type == "new_expression":
+                return False
+            if node.type == "call_expression":
+                function = field(node, "function")
+                cap = capability(function)
+                native = cap is not None and cap[0] in _NATIVE_MODULES
+                intrinsic_json = cap in {("ambient", "JSON.stringify"), ("ambient", "JSON.parse")}
+                primitive = (
+                    function is not None
+                    and function.type == "identifier"
+                    and text(function) in {"String", "Number", "Boolean"}
+                    and not definitions[text(function)]
+                )
+                if not (native or intrinsic_json or primitive or native_array_method(function)):
+                    return False
+            pending.extend(node.named_children)
+        return True
+
+    def contains_string(initial):
+        pending, seen = [initial], set()
+        while pending:
+            step()
+            node = pending.pop()
+            if node.id in seen:
+                continue
+            seen.add(node.id)
+            if node.type in {"string", "template_string"}:
+                return True
+            if node.type == "identifier" and len(definitions[text(node)]) == 1:
+                owner = parent(definitions[text(node)][0])
+                if owner is not None and owner.type == "variable_declarator":
+                    value = field(owner, "value")
+                    if value is not None:
+                        pending.append(value)
+            pending.extend(node.named_children)
+        return False
+
+    literals = []
+    for node in nodes:
+        if node.type == "template_string":
+            if not is_data(node):
+                return None
+            for child in node.children:
+                if child.type == "template_substitution" and not field_calls_are_data(child):
+                    return None
+            literals.append(node)
+        if node.type in {"binary_expression", "augmented_assignment_expression"}:
+            operator = field(node, "operator")
+            if (
+                operator is not None
+                and text(operator) in {"+", "+="}
+                and contains_string(node)
+                and not is_data(node)
+            ):
+                return None
+    # Mark syntax and quasi text, retaining the exact bytes of interpolation
+    # expressions. Nested source strings still have their own proven uses.
+    ranges = []
+    for node in nodes:
+        if node.type == "string" and is_data(node):
+            ranges.append((node.start_byte, node.end_byte))
+    for node in literals:
+        cursor = node.start_byte
+        for child in node.children:
+            if child.type == "template_substitution":
+                expressions = child.named_children
+                if len(expressions) != 1:
+                    return None
+                expression = expressions[0]
+                ranges.append((cursor, expression.start_byte))
+                cursor = expression.end_byte
+        ranges.append((cursor, node.end_byte))
+    return ranges
