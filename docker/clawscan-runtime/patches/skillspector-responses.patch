+"""Bounded format-aware decoding of a deliberately small passive PDF subset.
+
+Unknown dictionaries, fonts, operators, orphan objects and active features are
+unsupported. No PDF is rendered. qpdf runs in a separate resource-limited
+process, and successful output contains both decoded text and the original
+printable view so existing binary instruction signals remain available.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import io
+import json
+import math
+import re
+import subprocess
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+
+MAX_PDF_BYTES = 512 * 1024
+MAX_PDF_VIEW_BYTES = 256 * 1024
+MAX_PDF_OBJECTS = 256
+MAX_PDF_OPERATORS = 4096
+MAX_PDF_SECONDS = 5.0
+
+
+def decoded_pdf_security_text(content: str) -> str | None:
+    """Expose the bounded carrier's decoded characters as an additive scan view.
+
+    This is not PDF admission: the original JSON carrier must still be scanned.
+    A forged carrier in a text artifact can only add work, never hide source.
+    """
+    if len(content) > MAX_PDF_VIEW_BYTES or not content.startswith('{"format":'):
+        return None
+    try:
+        carrier = json.loads(content)
+    except (ValueError, RecursionError):
+        return None
+    if not isinstance(carrier, dict) or set(carrier) != {
+        "format", "source_sha256", "text", "raw_printable"
+    }:
+        return None
+    if carrier["format"] != "bounded-passive-pdf-v1":
+        return None
+    if not isinstance(carrier["source_sha256"], str) or not re.fullmatch(
+        r"[0-9a-f]{64}", carrier["source_sha256"]
+    ):
+        return None
+    texts = carrier["text"]
+    raw = carrier["raw_printable"]
+    if not isinstance(texts, list) or not all(isinstance(text, str) for text in texts):
+        return None
+    if not isinstance(raw, str):
+        return None
+    # Preserve actual Unicode and line/word boundaries; JSON escapes are a
+    # transport representation, not the text that the PDF reader exposes.
+    decoded = "\n\n".join([*texts, raw])
+    try:
+        if len(decoded.encode("utf-8")) > MAX_PDF_VIEW_BYTES:
+            return None
+    except UnicodeEncodeError:
+        # JSON permits escaped lone surrogates, but analyzer fingerprints and
+        # downstream report serializers require valid UTF-8. Keep the raw scan.
+        return None
+    return decoded
+
+
+@dataclass(frozen=True)
+class PdfInspection:
+    text: str | None
+    reason: str | None = None
+
+
+class UnsupportedPdfError(ValueError):
+    pass
+
+
+def _decode_passive(data: bytes) -> list[str]:
+    import pikepdf
+
+    terminal = re.search(rb"startxref\s+(\d+)\s+%%EOF\s*\Z", data)
+    if not data.startswith(b"%PDF-") or terminal is None or data.count(b"%%EOF") != 1:
+        raise UnsupportedPdfError
+    if not data[int(terminal.group(1)) :].startswith(b"xref"):
+        raise UnsupportedPdfError
+    text: list[str] = []
+    glyph_text: list[str] = []
+    visited: dict[tuple[int, int], str] = {}
+    font_names: set[str] = set()
+    active: dict[tuple[int, int], str] = {}
+    steps = 0
+
+    def spend() -> None:
+        nonlocal steps
+        steps += 1
+        if steps > MAX_PDF_OPERATORS:
+            raise UnsupportedPdfError
+
+    def string(value: object) -> None:
+        if not isinstance(value, pikepdf.String):
+            raise UnsupportedPdfError
+        text.append(str(value))
+
+    def number(value: object) -> None:
+        from decimal import Decimal
+
+        if isinstance(value, bool) or not isinstance(value, (int, Decimal)):
+            raise UnsupportedPdfError
+        if not math.isfinite(float(value)) or abs(value) > 1_000_000_000:
+            raise UnsupportedPdfError
+
+    def array(value: object, size: int | None = None) -> None:
+        if not isinstance(value, pikepdf.Array) or size is not None and len(value) != size:
+            raise UnsupportedPdfError
+        if len(value) > MAX_PDF_OBJECTS:
+            raise UnsupportedPdfError
+
+    def name(value: object, allowed: set[str]) -> None:
+        if not isinstance(value, pikepdf.Name) or str(value) not in allowed:
+            raise UnsupportedPdfError
+
+    def dictionary(value: object, allowed: set[str], required: set[str] = frozenset()) -> None:
+        if not isinstance(value, (pikepdf.Dictionary, pikepdf.Stream)):
+            raise UnsupportedPdfError
+        keys = set(value.keys())
+        if not required <= keys or not keys <= allowed:
+            raise UnsupportedPdfError
+
+    class TextLayout:
+        """Only horizontal black Helvetica text with provable reading order."""
+
+        def __init__(self, width: float, height: float):
+            self.width, self.height = width, height
+            self.in_text = False
+            self.font_size: float | None = None
+            self.x: float | None = None
+            self.y: float | None = None
+            self.shown = False
+            self.last_y: float | None = None
+            self.last_size = 0.0
+            self.column_x: float | None = None
+            self.ends_space = False
+
+        def consume(self, args, op: str) -> tuple[str, bool] | None:
+            if op == "cm":
+                for operand in args:
+                    number(operand)
+                if list(args) != [1, 0, 0, 1, 0, 0]:
+                    raise UnsupportedPdfError
+            elif op == "BT":
+                if args or self.in_text:
+                    raise UnsupportedPdfError
+                self.in_text = True
+                self.x = self.y = None
+                self.shown = False
+            elif op == "ET":
+                if args or not self.in_text:
+                    raise UnsupportedPdfError
+                self.in_text = False
+                self.x = self.y = None
+            elif op == "Tf":
+                if not self.in_text or len(args) != 2 or str(args[0]) not in font_names:
+                    raise UnsupportedPdfError
+                if not isinstance(args[0], pikepdf.Name) or self.shown and self.x is not None:
+                    raise UnsupportedPdfError
+                number(args[1])
+                if not 0 < args[1] <= 1440:
+                    raise UnsupportedPdfError
+                self.font_size = float(args[1])
+            elif op == "TL":
+                if not self.in_text or len(args) != 1:
+                    raise UnsupportedPdfError
+                number(args[0])
+            elif op == "T*":
+                if args or not self.in_text:
+                    raise UnsupportedPdfError
+                # A following show must establish a new explicit text matrix.
+                self.x = self.y = None
+                self.shown = False
+            elif op == "Tm":
+                if not self.in_text or len(args) != 6 or list(args[:4]) != [1, 0, 0, 1]:
+                    raise UnsupportedPdfError
+                for operand in args:
+                    number(operand)
+                self.x, self.y = float(args[4]), float(args[5])
+                self.shown = False
+            elif op in {"Tj", "TJ"}:
+                if (
+                    len(args) != 1
+                    or not self.in_text
+                    or self.x is None
+                    or self.y is None
+                    or self.font_size is None
+                ):
+                    raise UnsupportedPdfError
+                values = args[0] if op == "TJ" else [args[0]]
+                if op == "TJ":
+                    array(values)
+                fragments = []
+                for operand in values:
+                    if isinstance(operand, pikepdf.String):
+                        raw_text = bytes(operand)
+                        if not all(0x20 <= char <= 0x7E for char in raw_text):
+                            raise UnsupportedPdfError
+                        fragments.append(raw_text.decode("ascii"))
+                    elif op != "TJ" or type(operand) is not int or operand != 0:
+                        # Numeric TJ movement can introduce gaps or reorder text.
+                        raise UnsupportedPdfError
+                fragment = "".join(fragments)
+                if not fragment:
+                    return fragment, False
+                size = self.font_size
+                # Helvetica's AFM advance is at most1.015em and its font box
+                # lies within[-.166,-.225,1,.931]em. Round outward and leave
+                # an extra em at the right edge; never promote clipped glyphs.
+                advance_bound = len(fragment) * size * 1.02
+                if self.x < size * 0.2 or self.x + advance_bound + size > self.width:
+                    raise UnsupportedPdfError
+                if self.y < size * 0.25 or self.y + size > self.height:
+                    raise UnsupportedPdfError
+                new_line = not self.shown
+                # Text-matrix origins alone do not prove visible alignment:
+                # whitespace can recreate columns. Only ordinary single word
+                # spaces are supported; leading and repeated spaces, including
+                # across adjacent Tj/TJ fragments, remain unknown layouts.
+                if (
+                    "  " in fragment
+                    or new_line and fragment.startswith(" ")
+                    or not new_line and self.ends_space and fragment.startswith(" ")
+                ):
+                    raise UnsupportedPdfError
+                self.ends_space = fragment.endswith(" ")
+                if new_line:
+                    # Reading order must be a single column, not merely a
+                    # descending paint order alternating between columns.
+                    if self.column_x is not None and self.x != self.column_x:
+                        raise UnsupportedPdfError
+                    self.column_x = self.x
+                if (
+                    new_line
+                    and self.last_y is not None
+                    and self.last_y - self.y < 1.2 * max(size, self.last_size)
+                ):
+                    raise UnsupportedPdfError
+                self.shown = True
+                self.last_y, self.last_size = self.y, size
+                self.x += advance_bound
+                return fragment, new_line
+            else:
+                raise UnsupportedPdfError
+            return None
+
+    layout: TextLayout | None = None
+    continuous_glyphs: list[str] = []
+
+    def visit(value: object, role: str, depth: int = 0) -> None:
+        nonlocal layout, font_names
+        spend()
+        if depth > 24:
+            raise UnsupportedPdfError
+        identifier = value.objgen
+        if identifier != (0, 0):
+            if identifier in active:
+                raise UnsupportedPdfError
+            if identifier in visited:
+                if visited[identifier] != role:
+                    raise UnsupportedPdfError
+                if role != "content":
+                    return
+            active[identifier] = role
+        if role == "catalog":
+            dictionary(value, {"/Type", "/Pages", "/PageMode"}, {"/Type", "/Pages"})
+            name(value.Type, {"/Catalog"})
+            if "/PageMode" in value:
+                name(value.PageMode, {"/UseNone"})
+            visit(value.Pages, "pages", depth + 1)
+        elif role == "pages":
+            dictionary(value, {"/Type", "/Count", "/Kids"}, {"/Type", "/Count", "/Kids"})
+            name(value.Type, {"/Pages"})
+            array(value.Kids)
+            if type(value.Count) is not int or value.Count != len(value.Kids):
+                raise UnsupportedPdfError
+            page_ids = [page.objgen for page in value.Kids]
+            if (0, 0) in page_ids or len(set(page_ids)) != len(page_ids):
+                raise UnsupportedPdfError
+            for page in value.Kids:
+                visit(page, "page", depth + 1)
+        elif role == "page":
+            dictionary(
+                value,
+                {"/Type", "/Parent", "/MediaBox", "/Resources", "/Contents", "/Rotate", "/Trans"},
+                {"/Type", "/Parent", "/MediaBox", "/Resources", "/Contents"},
+            )
+            name(value.Type, {"/Page"})
+            if active.get(value.Parent.objgen) != "pages":
+                raise UnsupportedPdfError
+            array(value.MediaBox, 4)
+            for coordinate in value.MediaBox:
+                number(coordinate)
+            if list(value.MediaBox[:2]) != [0, 0] or not all(
+                0 < edge <= 14400 for edge in value.MediaBox[2:]
+            ):
+                raise UnsupportedPdfError
+            layout = TextLayout(float(value.MediaBox[2]), float(value.MediaBox[3]))
+            if "/Rotate" in value:
+                if type(value.Rotate) is not int or value.Rotate != 0:
+                    raise UnsupportedPdfError
+            if "/Trans" in value:
+                dictionary(value.Trans, set())
+            visit(value.Resources, "resources", depth + 1)
+            font_names = set(value.Resources.Font.keys())
+            contents = value.Contents
+            if isinstance(contents, pikepdf.Array):
+                array(contents)
+                for stream in contents:
+                    visit(stream, "content", depth + 1)
+            else:
+                visit(contents, "content", depth + 1)
+        elif role == "resources":
+            dictionary(value, {"/Font", "/ProcSet"}, {"/Font"})
+            fonts = value.Font
+            dictionary(fonts, set(fonts.keys()))
+            if len(fonts) > 32:
+                raise UnsupportedPdfError
+            if fonts.objgen != (0, 0):
+                if fonts.objgen in visited and visited[fonts.objgen] != "font-map":
+                    raise UnsupportedPdfError
+                visited[fonts.objgen] = "font-map"
+            font_names.update(fonts.keys())
+            for font in fonts.values():
+                visit(font, "font", depth + 1)
+            if "/ProcSet" in value:
+                array(value.ProcSet)
+                for proc in value.ProcSet:
+                    name(proc, {"/PDF", "/Text", "/ImageB", "/ImageC", "/ImageI"})
