diff --git a/mcp_scan/tools/file/inspect_file.py b/mcp_scan/tools/file/inspect_file.py
new file mode 100644
index 0000000..c6b1884
--- /dev/null
+++ b/mcp_scan/tools/file/inspect_file.py
@@ -0,0 +1,107 @@
+# ClawScan addition: bounded, read-only inspection tools confined to the
+# audited directory. They let the agent reach every part of a large or
+# compiled file without a shell. Outputs stay below the agent history's
+# truncation limit, so what a tool returns is what the model sees.
+
+import os
+import re
+from typing import Any
+
+from mcp_scan.tools.file.read_file import READ_FILE_MAX_BYTES, READ_FILE_MAX_CHARS, _is_path_allowed
+from mcp_scan.tools.registry import register_tool
+from mcp_scan.utils.tool_context import ToolContext
+
+SEARCH_MAX_RESULTS = 50
+SEARCH_CONTEXT_CHARS = 160
+SEARCH_MAX_OUTPUT_CHARS = 24000
+SEARCH_MAX_FILE_BYTES = READ_FILE_MAX_BYTES
+
+
+def _int_arg(value: Any, default: int) -> int:
+    try:
+        return int(str(value).strip())
+    except (TypeError, ValueError):
+        return default
+
+
+def _read_text(path: str) -> str:
+    with open(path, encoding="utf-8", errors="replace") as f:
+        return f.read()
+
+
+@register_tool
+def read_file_chunk(
+    file_path: str, offset: int = 0, length: int = READ_FILE_MAX_CHARS, context: ToolContext = None
+) -> dict[str, Any]:
+    """Read characters [offset, offset+length) of a file in the audited directory."""
+    if not _is_path_allowed(file_path, context):
+        return {"success": False, "message": f"Path is not allowed: {file_path}, you can only access the given directory"}
+    if not os.path.isfile(file_path):
+        return {"success": False, "message": f"File not found: {file_path}"}
+    if os.path.getsize(file_path) > READ_FILE_MAX_BYTES:
+        return {"success": False, "message": f"File is larger than {READ_FILE_MAX_BYTES >> 20} MiB; use search_files on it instead."}
+    try:
+        content = _read_text(file_path)
+    except Exception as e:
+        return {"success": False, "message": f"Error reading file: {e}"}
+    offset = max(_int_arg(offset, 0), 0)
+    length = min(max(_int_arg(length, READ_FILE_MAX_CHARS), 1), READ_FILE_MAX_CHARS)
+    end = min(offset + length, len(content))
+    next_offset = str(end) if end < len(content) else ""
+    return {
+        "message": f"Characters {offset}-{end} of {len(content)}.",
+        "next_offset": next_offset,
+        "data": content[offset:end],
+    }
+
+
+@register_tool
+def search_files(
+    pattern: str, path: str = "", ignore_case: str = "false", context: ToolContext = None
+) -> dict[str, Any]:
+    """Find a literal string in files under the audited directory."""
+    root = path or (context.folder if context else "")
+    if not root or not _is_path_allowed(root, context):
+        return {"success": False, "message": f"Path is not allowed: {root}, you can only access the given directory"}
+    needle = str(pattern or "")
+    if not needle:
+        return {"success": False, "message": "pattern must be a non-empty literal string"}
+    fold = str(ignore_case).strip().lower() in ("1", "true", "yes")
+    # Matching runs on the original text so reported offsets index the file.
+    matcher = re.compile(re.escape(needle), re.IGNORECASE if fold else 0)
+    files = [root] if os.path.isfile(root) else []
+    if not files:
+        for current, dirs, names in os.walk(root):
+            dirs.sort()
+            for name in sorted(names):
+                files.append(os.path.join(current, name))
+    lines = []
+    total = 0
+    omitted = 0
+    for file_path in files:
+        if not _is_path_allowed(file_path, context) or not os.path.isfile(file_path):
+            continue
+        try:
+            if os.path.getsize(file_path) > SEARCH_MAX_FILE_BYTES:
+                continue
+            content = _read_text(file_path)
+        except Exception:
+            continue
+        for match in matcher.finditer(content):
+            index = match.start()
+            if total >= SEARCH_MAX_RESULTS:
+                omitted += 1
+                continue
+            line = content.count("\n", 0, index) + 1
+            lo = max(index - SEARCH_CONTEXT_CHARS, 0)
+            hi = min(match.end() + SEARCH_CONTEXT_CHARS, len(content))
+            snippet = content[lo:hi].replace("\n", "\\n")
+            lines.append(f"{file_path}:{line} offset={index}: {snippet}")
+            total += 1
+    output = "\n".join(lines)
+    if len(output) > SEARCH_MAX_OUTPUT_CHARS:
+        output = output[:SEARCH_MAX_OUTPUT_CHARS] + "\n... (output limit reached; narrow the search)"
+    message = f"{total} match(es)"
+    if omitted:
+        message += f"; {omitted} more not shown, narrow the search"
+    return {"message": message + ". Read around a match with read_file_chunk(file_path, offset).", "data": output}
diff --git a/mcp_scan/tools/file/inspect_file_schema.xml b/mcp_scan/tools/file/inspect_file_schema.xml
new file mode 100644
index 0000000..c13dbbf
--- /dev/null
+++ b/mcp_scan/tools/file/inspect_file_schema.xml
@@ -0,0 +1,47 @@
+<tools>
+    <tool name="read_file_chunk">
+        <description>Read part of a file in the audited directory by character offset. Use it for large or compiled files: read_file returns at most 30000 characters, and anything after that is only visible through this tool.</description>
+        <parameters>
+            <parameter name="file_path" type="string" required="true">
+                <description>Path of the file, as used with read_file.</description>
+            </parameter>
+            <parameter name="offset" type="integer" required="false">
+                <description>Character offset to start at (default 0).</description>
+            </parameter>
+            <parameter name="length" type="integer" required="false">
+                <description>Number of characters to return (default and maximum 30000).</description>
+            </parameter>
+        </parameters>
+        <returns type="Dict[str, Any]">
+            <description>data: the characters read; next_offset: where to continue, empty at end of file.</description>
+        </returns>
+        <examples>
+            <function=read_file_chunk>
+            <parameter=file_path>plugin/dist/index.js</parameter>
+            <parameter=offset>30000</parameter>
+            </function>
+        </examples>
+    </tool>
+    <tool name="search_files">
+        <description>Find a literal string (not a regular expression) in files under the audited directory, or in one file. Returns file, line, character offset and surrounding text for up to 50 matches.</description>
+        <parameters>
+            <parameter name="pattern" type="string" required="true">
+                <description>Literal text to find, for example fetch( or process.env.</description>
+            </parameter>
+            <parameter name="path" type="string" required="false">
+                <description>File or directory to search (default: the audited directory).</description>
+            </parameter>
+            <parameter name="ignore_case" type="boolean" required="false">
+                <description>Set true for a case-insensitive search.</description>
+            </parameter>
+        </parameters>
+        <returns type="Dict[str, Any]">
+            <description>data: one line per match with path:line offset=N and context.</description>
+        </returns>
+        <examples>
+            <function=search_files>
+            <parameter=pattern>child_process</parameter>
+            </function>
+        </examples>
+    </tool>
+</tools>
